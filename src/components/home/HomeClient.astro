---
import LocalizationClient from "../i18n/LocalizationClient.astro";

import type { HomepageLocaleCode, HomepageLocalizedContent } from "../../lib/homepage/types";

interface Props {
  defaultLanguage: HomepageLocaleCode;
  localizedContent: HomepageLocalizedContent;
}

const { defaultLanguage, localizedContent } = Astro.props;
---

<LocalizationClient defaultLanguage={defaultLanguage} localizedContent={localizedContent} />
