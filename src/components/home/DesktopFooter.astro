---
import LanguageSwitcher from "../site/LanguageSwitcher.astro";

import { getFooterCtaHref, getFooterLinkHref } from "../../lib/homepage/links";

import type {
  HomepageLocaleContent,
  LanguageOption,
  SiteSettings,
} from "../../lib/homepage/types";

interface Props {
  locale: HomepageLocaleContent;
  languages: LanguageOption[];
  siteSettings: SiteSettings;
}

const { locale, languages, siteSettings } = Astro.props;
---

<footer class="desk-footer" id="desktop-footer">
  <div class="desk-footer-stripe"></div>

  <div class="desk-footer-cta">
    <div class="desk-wrap desk-footer-cta-inner">
      <div>
        <div class="desk-footer-eye" data-i18n="footerCta.eye">{locale.footerCta.eye}</div>
        <h2
          class="desk-footer-title"
          data-i18n-html="footerCta.titleHtml"
          set:html={locale.footerCta.titleHtml}
        ></h2>
      </div>
      <a
        href={getFooterCtaHref()}
        class="desk-btn desk-btn--red desk-btn--large"
        data-i18n="footerCta.button"
      >
        {locale.footerCta.button}
      </a>
    </div>
  </div>

  <div class="desk-wrap desk-footer-main">
    <div class="desk-footer-row">
      <div class="desk-footer-groups">
        {locale.footerColumns.map((column, columnIndex) => (
          <div class="desk-footer-group">
            <div class="desk-footer-group-title" data-i18n={`footerColumns.${columnIndex}.title`}>
              {column.title}
            </div>
            <div class="desk-footer-group-links">
              {column.links.map((link, linkIndex) => (
                <a
                  href={getFooterLinkHref(columnIndex, linkIndex)}
                  data-i18n={`footerColumns.${columnIndex}.links.${linkIndex}`}
                >
                  {link}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="desk-footer-newsletter">
        <div class="desk-footer-group-title" data-i18n="footer.newsletterTitle">
          {locale.footer.newsletterTitle}
        </div>
        <div class="desk-footer-newsletter-row">
          <input
            type="email"
            placeholder={locale.ui.newsletterPlaceholder}
            aria-label={locale.ui.newsletterEmail}
            data-i18n-placeholder="ui.newsletterPlaceholder"
            data-i18n-aria-label="ui.newsletterEmail"
          />
          <a
            href={siteSettings.newsletterUrl}
            target="_blank"
            rel="noreferrer"
            class="desk-footer-subscribe"
            data-i18n="footer.desktopSubscribe"
          >
            {locale.footer.desktopSubscribe}
          </a>
        </div>

        <div class="desk-footer-socials">
          <div class="desk-wechat">
            <button type="button" class="desk-social-btn" aria-label="WeChat">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.5 2C4.36 2 1 5.03 1 8.78c0 1.99.98 3.77 2.53 4.97L2.5 16l2.7-1.35C6.1 14.87 7.27 15 8.5 15c.28 0 .56-.01.83-.04A5.54 5.54 0 0 1 9 13.22C9 10.33 11.91 8 15.5 8c.28 0 .56.01.83.03C15.62 4.6 12.4 2 8.5 2zm-2 4.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm5 3.5c-3.04 0-5.5 2.01-5.5 4.5S12.46 19 15.5 19c.7 0 1.37-.12 1.98-.33L20 20l-1.12-2.34C19.56 16.73 21 15.19 21 13.5 21 11.01 18.54 9 15.5 9zm-1.5 2.75a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zm3 0a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"></path>
              </svg>
            </button>
            <div class="desk-wechat-popup">
              <div class="desk-wechat-title" data-i18n="footer.scanWechat">
                {locale.footer.scanWechat}
              </div>
              <div class="desk-wechat-qr">
                <svg viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <rect width="96" height="96" fill="white"></rect>
                  <rect x="8" y="8" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="12" y="12" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="16" y="16" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="56" y="8" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="60" y="12" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="64" y="16" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="8" y="56" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="12" y="60" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="16" y="64" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="48" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="60" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="48" y="60" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="60" width="8" height="8" fill="#111"></rect>
                  <rect x="48" y="72" width="8" height="8" fill="#111"></rect>
                  <rect x="60" y="72" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="72" width="8" height="8" fill="#111"></rect>
                </svg>
              </div>
            </div>
          </div>

          <a
            href={siteSettings.socialLinks.instagram}
            target="_blank"
            rel="noreferrer"
            class="desk-social-btn"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <a
            href={siteSettings.socialLinks.linkedin}
            target="_blank"
            rel="noreferrer"
            class="desk-social-btn"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>

          <a
            href={siteSettings.socialLinks.whatsapp}
            target="_blank"
            rel="noreferrer"
            class="desk-social-btn desk-social-btn--whatsapp"
            aria-label="WhatsApp"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.2 11.8a8.2 8.2 0 0 1-12.1 7.2L4 20.2l1.2-4a8.2 8.2 0 1 1 15-4.4z"></path>
              <path d="M9.5 8.8c.2-.4.4-.5.7-.5h.5c.2 0 .4.1.5.4l.5 1.2c.1.3.1.5-.1.7l-.4.5c.5 1 1.3 1.8 2.4 2.4l.5-.4c.2-.2.5-.2.7-.1l1.2.5c.3.1.4.3.4.6v.4c0 .4-.2.6-.5.8-.5.3-1.2.4-2 .2-2.3-.5-4.3-2.5-4.9-4.8-.1-.8.1-1.5.5-1.9z"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="desk-footer-lang">
        <LanguageSwitcher
          languages={languages}
          currentLanguage={languages[0].code}
          label={locale.ui.chooseLanguage}
          labelTranslationKey="ui.chooseLanguage"
          className="site-lang--footer"
          tone="dark"
        />
      </div>
    </div>
  </div>

  <div class="desk-footer-bottom-stripe"></div>
</footer>
