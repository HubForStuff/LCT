---
import DesktopFooter from "./DesktopFooter.astro";
import DesktopNavigation from "./DesktopNavigation.astro";
import SectionCallouts from "./SectionCallouts.astro";

import {
  HOMEPAGE_ROUTE_TARGETS,
  getCompetitionSectionHref,
  getNewsListingHref,
} from "../../lib/homepage/links";
import type { HomepageLocaleContent, LanguageOption, SiteSettings } from "../../lib/homepage/types";

interface Props {
  locale: HomepageLocaleContent;
  languages: LanguageOption[];
  siteSettings: SiteSettings;
}

const { locale, languages, siteSettings } = Astro.props;
---

<section class="desktop-home" aria-label="Desktop homepage">
  <DesktopNavigation locale={locale} languages={languages} siteSettings={siteSettings} />

  <section class="desk-hero">
    <video
      class="desk-hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/0ba5f31073cf8b69936f9480dca4dd0a.mp4" type="video/mp4" />
    </video>
    <div class="desk-wrap">
      <div class="desk-hero-copy desk-hero-pane">
        <h1 data-i18n-html="hero.desktopTitleHtml" set:html={locale.hero.desktopTitleHtml}></h1>
        <p class="desk-hero-sub" data-i18n="hero.subtitle">
          {locale.hero.subtitle}
        </p>
        <div class="desk-button-row">
          <a href="#desktop-categories" class="desk-btn desk-btn--white" data-i18n="hero.ctas.0">
            {locale.hero.ctas[0]}
          </a>
          <a href="#desktop-footer" class="desk-btn desk-btn--red" data-i18n="hero.ctas.1">
            {locale.hero.ctas[1]}
          </a>
          <a href="#desktop-news" class="desk-btn desk-btn--blue" data-i18n="hero.ctas.2">
            {locale.hero.ctas[2]}
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionCallouts locale={locale} variant="desktop" />

  <section class="desk-section desk-section--alt" id="desktop-competitions">
    <div class="desk-wrap">
      <div class="desk-section-top">
        <div>
          <div class="desk-section-eye" data-i18n="competitionsSection.eye">
            {locale.competitionsSection.eye}
          </div>
          <h2 class="desk-section-title" data-i18n="competitionsSection.desktopTitle">
            {locale.competitionsSection.desktopTitle}
          </h2>
        </div>
        <a
          href={HOMEPAGE_ROUTE_TARGETS.competitions}
          class="desk-section-link"
          data-i18n="competitionsSection.allLink"
        >
          {locale.competitionsSection.allLink}
        </a>
      </div>
    </div>

    <div class="desk-comp-grid">
      {locale.competitionCards.map((card, index) => (
        <a
          href={getCompetitionSectionHref(index)}
          class={`desk-comp-square desk-comp-square--${card.theme} desk-comp-square--light-shell`}
        >
          <div class="desk-comp-square-surface">
            <div class="desk-comp-content">
              <div class="desk-comp-label" data-i18n={`competitionCards.${index}.label`}>{card.label}</div>
              <div
                class="desk-comp-title"
                data-i18n-html={`competitionCards.${index}.titleHtml`}
                set:html={card.titleHtml}
              ></div>
              <p class="desk-comp-desc" data-i18n={`competitionCards.${index}.description`}>
                {card.description}
              </p>
              <div class="desk-comp-badge" data-i18n={`competitionCards.${index}.status`}>{card.status}</div>
              <div class="desk-comp-cta" data-i18n={`competitionCards.${index}.cta`}>{card.cta}</div>
            </div>
            <div class="desk-comp-watermark" data-i18n={`competitionCards.${index}.watermark`}>
              {card.watermark}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="desk-section desk-news" id="desktop-news">
    <div class="desk-wrap">
      <div class="desk-section-top">
        <div>
          <div class="desk-section-eye" data-i18n="newsSection.eye">{locale.newsSection.eye}</div>
          <h2 class="desk-section-title" data-i18n="newsSection.title">{locale.newsSection.title}</h2>
        </div>
        <a href={getNewsListingHref()} class="desk-section-link" data-i18n="newsSection.allLink">
          {locale.newsSection.allLink}
        </a>
      </div>

      <div class="desk-news-grid">
        {locale.newsItems.map((item, index) => (
          <a href={item.href} class="desk-news-card desk-news-card--shell">
            <div class="desk-news-card-inner">
              <div class="desk-news-body">
                <div class="desk-news-title" data-i18n={`newsItems.${index}.title`}>{item.title}</div>
              </div>
              <div class="desk-news-media">
                <div class="desk-news-image" style={`background-image:url('${item.image}')`}></div>
                <div
                  class="desk-news-image desk-news-image--alt"
                  style={`background-image:url('${item.altImage}')`}
                ></div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <DesktopFooter locale={locale} languages={languages} siteSettings={siteSettings} />
</section>
