---
const currentYear = new Date().getFullYear();

const footerLinks = {
  programs: [
    { label: 'Programas de Expansão', href: '#programas' },
    { label: 'Parcerias de Inovação', href: '#parcerias' },
    { label: 'Consultoria', href: '#consultoria' },
  ],
  competitions: [
    { label: 'Competições Ativas', href: '#competicoes' },
    { label: 'Desafios', href: '#desafios' },
    { label: 'Inscrever-se', href: '#inscricao' },
  ],
  events: [
    { label: 'Próximos Eventos', href: '#eventos' },
    { label: 'Workshops', href: '#workshops' },
    { label: 'Networking', href: '#networking' },
  ],
  about: [
    { label: 'Sobre Nós', href: '#sobre' },
    { label: 'Equipe', href: '#equipe' },
    { label: 'Contato', href: '#contato' },
  ],
};

const socialLinks = [
  { name: 'LinkedIn', href: '#', icon: 'linkedin' },
  { name: 'Twitter', href: '#', icon: 'twitter' },
  { name: 'Instagram', href: '#', icon: 'instagram' },
  { name: 'YouTube', href: '#', icon: 'youtube' },
];
---

<footer class="bg-gray-900 text-white">
  {/* Get Involved CTA */}
  <div class="border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Faça Parte da Inovação</h2>
        <p class="text-gray-400 mb-8 max-w-2xl mx-auto">
          Junte-se a centenas de empresas e empreendedores que estão transformando o futuro dos negócios.
        </p>
        <a href="#contato" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-white rounded-full hover:bg-gray-100 transition-all duration-200">
          Entre em Contato
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Main Footer */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      {/* Brand */}
      <div class="col-span-2 md:col-span-4 lg:col-span-1 mb-8 lg:mb-0">
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-accent-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold">IH</span>
          </div>
          <span class="font-bold text-xl">Inovação<span class="text-primary-400">Hub</span></span>
        </div>
        <p class="text-gray-400 text-sm mb-6">
          Conectando ideias, impulsionando negócios e criando oportunidades para empresas inovadoras.
        </p>
        {/* Social Links */}
        <div class="flex space-x-4">
          {socialLinks.map(link => (
            <a href={link.href} class="text-gray-400 hover:text-white transition-colors" aria-label={link.name}>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                {link.icon === 'linkedin' && (
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                )}
                {link.icon === 'twitter' && (
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                )}
                {link.icon === 'instagram' && (
                  <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
                )}
                {link.icon === 'youtube' && (
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>

      {/* Links */}
      <div>
        <h3 class="font-semibold text-white mb-4">Programas</h3>
        <ul class="space-y-3">
          {footerLinks.programs.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Competições</h3>
        <ul class="space-y-3">
          {footerLinks.competitions.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Eventos</h3>
        <ul class="space-y-3">
          {footerLinks.events.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Sobre</h3>
        <ul class="space-y-3">
          {footerLinks.about.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom */}
    <div class="border-t border-gray-800 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        © {currentYear} Inovação Hub. Todos os direitos reservados.
      </p>
      <div class="flex space-x-6 mt-4 sm:mt-0">
        <a href="#" class="text-gray-400 hover:text-white transition-colors text-sm">Privacidade</a>
        <a href="#" class="text-gray-400 hover:text-white transition-colors text-sm">Termos</a>
        <a href="#" class="text-gray-400 hover:text-white transition-colors text-sm">Cookies</a>
      </div>
    </div>
  </div>
</footer>