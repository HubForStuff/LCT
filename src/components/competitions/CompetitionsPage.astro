---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";

import type { CompetitionListingRouteLocale } from "../../lib/competitions/types";
import type { HomepageLocaleCode, SiteSettings } from "../../lib/homepage/types";

interface Props {
  locale: CompetitionListingRouteLocale;
  siteSettings: SiteSettings;
  currentLanguage: HomepageLocaleCode;
}

const { locale, siteSettings, currentLanguage } = Astro.props;
const page = locale.page;
---

<div class="interior-page">
  <InteriorHeader
    navItems={locale.navItems}
    activeHref="/competitions/"
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
    languageLabel={locale.ui.chooseLanguage}
    homeLabel={locale.ui.homeLabel}
    desktopMenuSections={locale.desktopMenuSections}
    navExploreLabel={locale.navExploreLabel}
  />

  <main>
    <section class="page-header">
      <div class="interior-wrap page-header-inner">
        <div>
          <div class="page-eyebrow" data-i18n="page.eyebrow">
            <span class="dot"></span>
            {page.eyebrow}
          </div>
          <h1 class="page-title" data-i18n-html="page.titleHtml" set:html={page.titleHtml}></h1>
        </div>
      </div>
    </section>

    <section class="interior-wrap competitions-shell">
      <div
        class="filters-bar"
        aria-label={page.filtersAriaLabel}
        data-i18n-aria-label="page.filtersAriaLabel"
      >
        <span class="filter-group-label" data-i18n="page.statusLabel">{page.statusLabel}</span>
        {page.statusFilters.map((filter, filterIndex) => (
          <button
            type="button"
            class:list={[
              "filter-pill",
              `filter-pill--${filter.tone}`,
              filter.active && "is-active",
            ]}
            data-status-filter={filter.value ?? filter.tone}
          >
            <span class="filter-pill-icon"></span>
            <span data-i18n={`page.statusFilters.${filterIndex}.label`}>{filter.label}</span>
          </button>
        ))}

        <span class="filter-separator" aria-hidden="true"></span>

        <span class="filter-group-label" data-i18n="page.focusLabel">{page.focusLabel}</span>
        {page.focusFilters.map((filter, filterIndex) => (
          <button
            type="button"
            class:list={[
              "filter-pill",
              `filter-pill--${filter.tone}`,
              filter.active && "is-active",
            ]}
            data-focus-filter={filter.value ?? filter.tone}
          >
            <span class="filter-pill-icon"></span>
            <span data-i18n={`page.focusFilters.${filterIndex}.label`}>{filter.label}</span>
          </button>
        ))}
      </div>

      <div class="tab-bar">
        <div class="tab-group" role="tablist" aria-label={page.tabsAriaLabel} data-i18n-aria-label="page.tabsAriaLabel">
          {page.tabs.map((tab, tabIndex) => (
            <button
              type="button"
              class:list={["tab", tabIndex === 0 && "is-active"]}
              role="tab"
              aria-selected={tabIndex === 0 ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              data-tab-trigger={tab.id}
            >
              <span data-i18n={`page.tabs.${tabIndex}.label`}>{tab.label}</span>
              <span class="tab-count">{tab.count}</span>
            </button>
          ))}
        </div>

        <div class="tab-sort">
          <label
            class="sr-only"
            for="competitionSort"
            data-i18n="page.sortLabel"
          >
            {page.sortLabel}
          </label>
          <select id="competitionSort" class="sort-select">
            {page.sortOptions.map((option, optionIndex) => (
              <option data-i18n={`page.sortOptions.${optionIndex}`}>{option}</option>
            ))}
          </select>
        </div>
      </div>

      {page.tabs.map((tab, tabIndex) => (
        <section
          class:list={["tab-panel", tabIndex === 0 && "is-active"]}
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-tab-panel={tab.id}
          hidden={tabIndex !== 0}
        >
          {tab.featured && (
            <article
              class:list={["featured-card", `featured-card--${tab.featured.theme}`]}
              data-filter-item
              data-status={tab.featured.statusTone}
              data-focuses={tab.featured.focusKeys.join(" ")}
            >
              <div class="featured-visual">
                <div class="featured-visual-grid"></div>
                <div class="featured-watermark" data-i18n={`page.tabs.${tabIndex}.featured.watermark`}>
                  {tab.featured.watermark}
                </div>
                <div class="featured-accent"></div>
              </div>

              <div class="featured-body">
                <div>
                  <div class="featured-tag-pill" data-i18n={`page.tabs.${tabIndex}.featured.tag`}>
                    <span class:list={[
                      "featured-star",
                      tab.featured.theme === "corporate" && "featured-star--blue",
                    ]}>&#9733;</span>
                    {tab.featured.tag}
                  </div>
                  <div class="featured-category" data-i18n={`page.tabs.${tabIndex}.featured.category`}>
                    {tab.featured.category}
                  </div>
                  <h2 class="featured-title">
                    <a
                      href={tab.featured.href}
                      class="competition-name-link"
                      data-competition-name-link={tab.featured.slug}
                      data-i18n={`page.tabs.${tabIndex}.featured.title`}
                    >
                      {tab.featured.title}
                    </a>
                  </h2>
                  <p class="featured-description" data-i18n={`page.tabs.${tabIndex}.featured.description`}>
                    {tab.featured.description}
                  </p>
                </div>

                <div>
                  <div class="featured-value-row">
                    <div class="featured-value" data-i18n={`page.tabs.${tabIndex}.featured.value`}>
                      {tab.featured.value}
                    </div>
                    <div
                      class="featured-value-caption"
                      data-i18n={`page.tabs.${tabIndex}.featured.valueCaption`}
                    >
                      {tab.featured.valueCaption}
                    </div>
                  </div>

                  <div class="featured-footer">
                    <div class="featured-status">
                      <span class="status-dot"></span>
                      <span data-i18n={`page.tabs.${tabIndex}.featured.status`}>{tab.featured.status}</span>
                    </div>
                    <div class="featured-deadline">
                      <span data-i18n={`page.tabs.${tabIndex}.featured.deadlinePrefix`}>
                        {tab.featured.deadlinePrefix}
                      </span>{" "}
                      <strong data-i18n={`page.tabs.${tabIndex}.featured.deadlineValue`}>
                        {tab.featured.deadlineValue}
                      </strong>
                    </div>
                    <a href={tab.featured.href} class="site-btn site-btn--primary site-btn--compact">
                      <span data-i18n={`page.tabs.${tabIndex}.featured.ctaLabel`}>
                        {tab.featured.ctaLabel}
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          )}

          {tab.cards && (
            <>
              <div class="comp-grid">
                {tab.cards.map((card, cardIndex) => (
                  <article
                    class:list={["ccard", `ccard--${card.accent}`]}
                    data-filter-item
                    data-status={card.statusTone}
                    data-focuses={card.focusKeys.join(" ")}
                  >
                    <div class="ccard-image">
                      <div class="ccard-grid"></div>
                      <span class:list={["ccard-badge", `ccard-badge--${card.statusTone}`]}>
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.status`}>{card.status}</span>
                      </span>
                      <div class="ccard-prize" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.prize`}>
                        {card.prize}
                      </div>
                      <div class="ccard-watermark" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.watermark`}>
                        {card.watermark}
                      </div>
                    </div>

                    <div class="ccard-body">
                      <div class="ccard-category" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.category`}>
                        {card.category}
                      </div>
                      <h3 class="ccard-name">
                        <a
                          href={card.href}
                          class="competition-name-link"
                          data-competition-name-link={card.slug}
                          data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.name`}
                        >
                          {card.name}
                        </a>
                      </h3>
                      <p
                        class="ccard-description"
                        data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.description`}
                      >
                        {card.description}
                      </p>
                    </div>

                    <div class="ccard-footer">
                      <div class="ccard-deadline">
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.deadlinePrefix`}>
                          {card.deadlinePrefix}
                        </span>{" "}
                        <strong data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.deadlineValue`}>
                          {card.deadlineValue}
                        </strong>
                      </div>
                      <a href={card.href} class="ccard-apply">
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.ctaLabel`}>
                          {card.ctaLabel}
                        </span>
                      </a>
                    </div>
                  </article>
                ))}

                {tab.placeholderLabel && (
                  <div class="ccard-placeholder">
                    <div class="ccard-placeholder-label" data-i18n={`page.tabs.${tabIndex}.placeholderLabel`}>
                      {tab.placeholderLabel}
                    </div>
                  </div>
                )}
              </div>

              <div class="load-more">
                <button type="button" class="site-btn site-btn--secondary" data-i18n="page.loadMoreLabel">
                  {page.loadMoreLabel}
                </button>
              </div>
            </>
          )}

          {!tab.cards && (
            <div class="empty-panel">
              <h3 data-i18n={`page.tabs.${tabIndex}.emptyStateTitle`}>{tab.emptyStateTitle}</h3>
              <p data-i18n={`page.tabs.${tabIndex}.emptyStateBody`}>{tab.emptyStateBody}</p>
            </div>
          )}
        </section>
      ))}
    </section>
  </main>

  <InteriorFooter footer={locale.footer} ui={locale.ui} siteSettings={siteSettings} currentLanguage={currentLanguage} />
</div>

<script>
  const tabTriggers = Array.from(document.querySelectorAll("[data-tab-trigger]"));
  const tabPanels = Array.from(document.querySelectorAll("[data-tab-panel]"));
  const statusFilterButtons = Array.from(document.querySelectorAll("[data-status-filter]"));
  const focusFilterButtons = Array.from(document.querySelectorAll("[data-focus-filter]"));
  let activeStatusFilter = "all";
  let activeFocusFilter = "all";

  function activateTab(tabId) {
    tabTriggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabTrigger === tabId;
      trigger.classList.toggle("is-active", isActive);
      trigger.setAttribute("aria-selected", isActive ? "true" : "false");
    });

    tabPanels.forEach((panel) => {
      const isActive = panel.dataset.tabPanel === tabId;
      panel.classList.toggle("is-active", isActive);
      panel.hidden = !isActive;
    });
  }

  function applyFilters() {
    const filterItems = Array.from(document.querySelectorAll("[data-filter-item]"));

    filterItems.forEach((item) => {
      const status = item.dataset.status || "open";
      const focuses = (item.dataset.focuses || "").split(" ").filter(Boolean);
      const matchesStatus = activeStatusFilter === "all" || status === activeStatusFilter;
      const matchesFocus = activeFocusFilter === "all" || focuses.includes(activeFocusFilter);
      item.hidden = !(matchesStatus && matchesFocus);
    });

    tabTriggers.forEach((trigger) => {
      const tabId = trigger.dataset.tabTrigger;
      const countNode = trigger.querySelector(".tab-count");
      const panel = tabId
        ? document.querySelector(`[data-tab-panel="${tabId}"]`)
        : null;

      if (!(countNode instanceof HTMLElement) || !(panel instanceof HTMLElement)) {
        return;
      }

      const visibleCount = Array.from(panel.querySelectorAll("[data-filter-item]")).filter(
        (item) => !item.hasAttribute("hidden"),
      ).length;

      countNode.textContent = String(visibleCount);
    });
  }

  function activateFilter(buttons, targetValue, activeClassName) {
    buttons.forEach((button) => {
      const currentValue =
        button.dataset.statusFilter || button.dataset.focusFilter || "";
      button.classList.toggle(activeClassName, currentValue === targetValue);
    });
  }

  function revealFirstVisibleItem() {
    const activePanel = tabPanels.find((panel) => !panel.hidden);
    const firstVisibleItem = activePanel
      ? Array.from(activePanel.querySelectorAll("[data-filter-item]")).find((item) => !item.hidden)
      : undefined;

    if (firstVisibleItem instanceof HTMLElement) {
      firstVisibleItem.scrollIntoView({ block: "start", behavior: "auto" });
    }
  }

  tabTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => activateTab(trigger.dataset.tabTrigger));
  });

  statusFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeStatusFilter = button.dataset.statusFilter || "all";
      activateFilter(statusFilterButtons, activeStatusFilter, "is-active");
      applyFilters();
      if (activeStatusFilter !== "all" && activeFocusFilter !== "all") {
        revealFirstVisibleItem();
      }
    });
  });

  focusFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFocusFilter = button.dataset.focusFilter || "all";
      activateFilter(focusFilterButtons, activeFocusFilter, "is-active");
      applyFilters();
      if (activeStatusFilter !== "all" && activeFocusFilter !== "all") {
        revealFirstVisibleItem();
      }
    });
  });

  applyFilters();

  // Activate tab from URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const tabParam = urlParams.get("tab");
  if (tabParam) {
    const matchingTrigger = tabTriggers.find(
      (trigger) => trigger.dataset.tabTrigger === tabParam
    );
    if (matchingTrigger) {
      activateTab(tabParam);
      applyFilters();
    }
  }
</script>
