---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";

import type { CompetitionListingRouteLocale } from "../../lib/competitions/types";
import type { HomepageLocaleCode, SiteSettings } from "../../lib/homepage/types";

interface Props {
  locale: CompetitionListingRouteLocale;
  siteSettings: SiteSettings;
  currentLanguage: HomepageLocaleCode;
}

const { locale, siteSettings, currentLanguage } = Astro.props;
const page = locale.page;

const STATUS_FILTER_ICONS: Record<string, string> = {
  open:
    '<svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><circle cx="4.5" cy="4.5" r="3.5" fill="#22c55e"></circle></svg>',
  future:
    '<svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><circle cx="4.5" cy="4.5" r="3.5" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="2 1.5"></circle></svg>',
  closed:
    '<svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><rect x="1" y="1" width="7" height="7" rx="1.5" stroke="#94a3b8" stroke-width="1.5"></rect><line x1="3" y1="4.5" x2="6" y2="4.5" stroke="#94a3b8" stroke-width="1.5"></line></svg>',
};

const FOCUS_FILTER_ICONS: Record<string, string> = {
  "deep-tech":
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><polygon points="6.5,1.5 11.5,11 1.5,11" stroke="#6366f1" stroke-width="1.6" fill="none"></polygon></svg>',
  sustainability:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M6.5 1.5C6.5 1.5 3 5 3 7.5a3.5 3.5 0 007 0c0-2.5-3.5-6-3.5-6z" stroke="#22c55e" stroke-width="1.6" fill="none"></path></svg>',
  fintech:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><rect x="2" y="4" width="9" height="7" rx="1.5" stroke="#3b82f6" stroke-width="1.5" fill="none"></rect><path d="M4.5 4V3a2 2 0 014 0v1" stroke="#3b82f6" stroke-width="1.5"></path></svg>',
  agritech:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M6.5 11.5V5M6.5 5C6.5 5 4 3 2 4c1.5 1.8 3 3.5 4.5 1zM6.5 5c0 0 2.5-2 4.5-1-1.5 1.8-3 3.5-4.5 1z" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round"></path></svg>',
  ai:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="2.2" stroke="#8b5cf6" stroke-width="1.5"></circle><path d="M6.5 1.5V3M6.5 10V11.5M1.5 6.5H3M10 6.5H11.5" stroke="#8b5cf6" stroke-width="1.4" stroke-linecap="round"></path></svg>',
  healthtech:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M6.5 11.5C6.5 11.5 2 8.5 2 5.5a2.8 2.8 0 015.5 0 2.8 2.8 0 015.5 0c0 3-6.5 6-6.5 6z" stroke="#f43f5e" stroke-width="1.5" fill="none"></path></svg>',
  logistics:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><rect x="1" y="5" width="7.5" height="5" rx="1" stroke="#f59e0b" stroke-width="1.4" fill="none"></rect><path d="M8.5 6.5h1.8l2 2.5v1H8.5V6.5z" stroke="#f59e0b" stroke-width="1.3" stroke-linejoin="round" fill="none"></path><circle cx="3.5" cy="11" r="1.1" stroke="#f59e0b" stroke-width="1.3"></circle><circle cx="10.2" cy="11" r="1.1" stroke="#f59e0b" stroke-width="1.3"></circle></svg>',
  biotech:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><ellipse cx="5.5" cy="6.5" rx="2.2" ry="4.5" stroke="#14b8a6" stroke-width="1.4" fill="none"></ellipse><ellipse cx="7.5" cy="6.5" rx="2.2" ry="4.5" stroke="#14b8a6" stroke-width="1.4" fill="none"></ellipse></svg>',
  manufacturing:
    '<svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M1.5 11L4.5 6.5l3 3L11 4l2 7H1.5z" stroke="#64748b" stroke-width="1.4" stroke-linejoin="round" fill="none"></path></svg>',
};

function getFilterIconMarkup(kind: "status" | "focus", value?: string): string {
  if (!value) {
    return "";
  }

  return kind === "status"
    ? STATUS_FILTER_ICONS[value] ?? ""
    : FOCUS_FILTER_ICONS[value] ?? "";
}
---

<div class="interior-page">
  <InteriorHeader
    navItems={locale.navItems}
    activeHref="/competitions/"
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
    languageLabel={locale.ui.chooseLanguage}
    homeLabel={locale.ui.homeLabel}
    desktopMenuSections={locale.desktopMenuSections}
    navExploreLabel={locale.navExploreLabel}
  />

  <main>
    <section class="page-header">
      <div class="interior-wrap page-header-inner">
        <div>
          <div class="page-eyebrow" data-i18n="page.eyebrow">
            <span class="dot"></span>
            {page.eyebrow}
          </div>
          <h1 class="page-title" data-i18n-html="page.titleHtml" set:html={page.titleHtml}></h1>
        </div>
      </div>
    </section>

    <section class="interior-wrap competitions-shell">
      <div
        class="filters-bar"
        aria-label={page.filtersAriaLabel}
        data-i18n-aria-label="page.filtersAriaLabel"
      >
        <span class="filter-group-label" data-i18n="page.statusLabel">{page.statusLabel}</span>
        {page.statusFilters.map((filter, filterIndex) => {
          const filterValue = filter.value ?? filter.tone;
          const iconMarkup = getFilterIconMarkup("status", filterValue);

          return (
            <button
              type="button"
              class:list={[
                "filter-pill",
                `filter-pill--${filter.tone}`,
                filter.active && "is-active",
              ]}
              data-status-filter={filterValue}
            >
              {iconMarkup && (
                <span class="filter-pill-icon" aria-hidden="true" set:html={iconMarkup}></span>
              )}
              <span data-i18n={`page.statusFilters.${filterIndex}.label`}>{filter.label}</span>
            </button>
          );
        })}

        <span class="filter-separator" aria-hidden="true"></span>

        <span class="filter-group-label" data-i18n="page.focusLabel">{page.focusLabel}</span>
        {page.focusFilters.map((filter, filterIndex) => {
          const filterValue = filter.value ?? filter.tone;
          const iconMarkup = getFilterIconMarkup("focus", filterValue);

          return (
            <button
              type="button"
              class:list={[
                "filter-pill",
                `filter-pill--${filter.tone}`,
                filter.active && "is-active",
              ]}
              data-focus-filter={filterValue}
            >
              {iconMarkup && (
                <span class="filter-pill-icon" aria-hidden="true" set:html={iconMarkup}></span>
              )}
              <span data-i18n={`page.focusFilters.${filterIndex}.label`}>{filter.label}</span>
            </button>
          );
        })}
      </div>

      <div class="tab-bar">
        <div class="tab-group" role="tablist" aria-label={page.tabsAriaLabel} data-i18n-aria-label="page.tabsAriaLabel">
          {page.tabs.map((tab, tabIndex) => (
            <button
              type="button"
              class:list={["tab", tabIndex === 0 && "is-active"]}
              role="tab"
              aria-selected={tabIndex === 0 ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              data-tab-trigger={tab.id}
            >
              <span data-i18n={`page.tabs.${tabIndex}.label`}>{tab.label}</span>
              <span class="tab-count">{tab.count}</span>
            </button>
          ))}
        </div>

        <div class="tab-sort">
          <label
            class="sr-only"
            for="competitionSort"
            data-i18n="page.sortLabel"
          >
            {page.sortLabel}
          </label>
          <select id="competitionSort" class="sort-select">
            {page.sortOptions.map((option, optionIndex) => (
              <option data-i18n={`page.sortOptions.${optionIndex}`}>{option}</option>
            ))}
          </select>
        </div>
      </div>

      {page.tabs.map((tab, tabIndex) => (
        <section
          class:list={["tab-panel", tabIndex === 0 && "is-active"]}
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-tab-panel={tab.id}
          hidden={tabIndex !== 0}
        >
          {tab.featured && (
            <article
              class:list={["featured-card", `featured-card--${tab.featured.theme}`]}
              data-filter-item
              data-status={tab.featured.statusTone}
              data-focuses={tab.featured.focusKeys.join(" ")}
            >
              <div class="featured-visual">
                <div class="featured-visual-grid"></div>
                <div class="featured-watermark" data-i18n={`page.tabs.${tabIndex}.featured.watermark`}>
                  {tab.featured.watermark}
                </div>
                <div class="featured-accent"></div>
              </div>

              <div class="featured-body">
                <div>
                  <div class="featured-tag-pill">
                    <span
                      class:list={[
                        "featured-star",
                        tab.featured.theme === "corporate" && "featured-star--blue",
                      ]}
                      aria-hidden="true"
                    >
                      &#9733;
                    </span>
                    <span data-i18n={`page.tabs.${tabIndex}.featured.tag`}>{tab.featured.tag}</span>
                  </div>
                  <div class="featured-category">
                    <span class="featured-cat-dot" aria-hidden="true"></span>
                    <span data-i18n={`page.tabs.${tabIndex}.featured.category`}>
                      {tab.featured.category}
                    </span>
                  </div>
                  <h2 class="featured-title">
                    <a
                      href={tab.featured.href}
                      class="competition-name-link"
                      data-competition-name-link={tab.featured.slug}
                      data-i18n={`page.tabs.${tabIndex}.featured.title`}
                    >
                      {tab.featured.title}
                    </a>
                  </h2>
                  <p class="featured-description" data-i18n={`page.tabs.${tabIndex}.featured.description`}>
                    {tab.featured.description}
                  </p>
                </div>

                <div>
                  <div class="featured-value-row">
                    <div class="featured-value" data-i18n={`page.tabs.${tabIndex}.featured.value`}>
                      {tab.featured.value}
                    </div>
                    <div
                      class="featured-value-caption"
                      data-i18n={`page.tabs.${tabIndex}.featured.valueCaption`}
                    >
                      {tab.featured.valueCaption}
                    </div>
                  </div>

                  <div class="featured-footer">
                    <div class="featured-status">
                      <span class="status-dot"></span>
                      <span data-i18n={`page.tabs.${tabIndex}.featured.status`}>{tab.featured.status}</span>
                    </div>
                    <div class="featured-deadline">
                      <span data-i18n={`page.tabs.${tabIndex}.featured.deadlinePrefix`}>
                        {tab.featured.deadlinePrefix}
                      </span>{" "}
                      <strong data-i18n={`page.tabs.${tabIndex}.featured.deadlineValue`}>
                        {tab.featured.deadlineValue}
                      </strong>
                    </div>
                    <a href={tab.featured.href} class="site-btn site-btn--primary site-btn--compact">
                      <span data-i18n={`page.tabs.${tabIndex}.featured.ctaLabel`}>
                        {tab.featured.ctaLabel}
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          )}

          {tab.cards && (
            <>
              <div class="comp-grid">
                {tab.cards.map((card, cardIndex) => (
                  <article
                    class:list={["ccard", `ccard--${card.accent}`]}
                    data-filter-item
                    data-status={card.statusTone}
                    data-focuses={card.focusKeys.join(" ")}
                  >
                    <div class="ccard-image">
                      <div class="ccard-grid"></div>
                      <span class:list={["ccard-badge", `ccard-badge--${card.statusTone}`]}>
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.status`}>{card.status}</span>
                      </span>
                      <div class="ccard-prize" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.prize`}>
                        {card.prize}
                      </div>
                      <div class="ccard-watermark" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.watermark`}>
                        {card.watermark}
                      </div>
                    </div>

                    <div class="ccard-body">
                      <div class="ccard-category" data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.category`}>
                        {card.category}
                      </div>
                      <h3 class="ccard-name">
                        <a
                          href={card.href}
                          class="competition-name-link"
                          data-competition-name-link={card.slug}
                          data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.name`}
                        >
                          {card.name}
                        </a>
                      </h3>
                      <p
                        class="ccard-description"
                        data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.description`}
                      >
                        {card.description}
                      </p>
                    </div>

                    <div class="ccard-footer">
                      <div class="ccard-deadline">
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.deadlinePrefix`}>
                          {card.deadlinePrefix}
                        </span>{" "}
                        <strong data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.deadlineValue`}>
                          {card.deadlineValue}
                        </strong>
                      </div>
                      <a href={card.href} class="ccard-apply">
                        <span data-i18n={`page.tabs.${tabIndex}.cards.${cardIndex}.ctaLabel`}>
                          {card.ctaLabel}
                        </span>
                      </a>
                    </div>
                  </article>
                ))}

                {tab.placeholderLabel && (
                  <div class="ccard-placeholder">
                    <div class="ccard-placeholder-label" data-i18n={`page.tabs.${tabIndex}.placeholderLabel`}>
                      {tab.placeholderLabel}
                    </div>
                  </div>
                )}
              </div>

              <div class="load-more">
                <button type="button" class="site-btn site-btn--secondary" data-i18n="page.loadMoreLabel">
                  {page.loadMoreLabel}
                </button>
              </div>
            </>
          )}

          {!tab.cards && (
            <div class="empty-panel">
              <h3 data-i18n={`page.tabs.${tabIndex}.emptyStateTitle`}>{tab.emptyStateTitle}</h3>
              <p data-i18n={`page.tabs.${tabIndex}.emptyStateBody`}>{tab.emptyStateBody}</p>
            </div>
          )}
        </section>
      ))}
    </section>
  </main>

  <InteriorFooter footer={locale.footer} ui={locale.ui} siteSettings={siteSettings} currentLanguage={currentLanguage} />
</div>

<script>
  const tabTriggers = Array.from(document.querySelectorAll("[data-tab-trigger]"));
  const tabPanels = Array.from(document.querySelectorAll("[data-tab-panel]"));
  const statusFilterButtons = Array.from(document.querySelectorAll("[data-status-filter]"));
  const focusFilterButtons = Array.from(document.querySelectorAll("[data-focus-filter]"));
  const competitionSortSelect = document.getElementById("competitionSort");
  let activeStatusFilter = "all";
  let activeFocusFilter = "all";

  function activateTab(tabId) {
    tabTriggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabTrigger === tabId;
      trigger.classList.toggle("is-active", isActive);
      trigger.setAttribute("aria-selected", isActive ? "true" : "false");
    });

    tabPanels.forEach((panel) => {
      const isActive = panel.dataset.tabPanel === tabId;
      panel.classList.toggle("is-active", isActive);
      panel.hidden = !isActive;
    });
  }

  function applyFilters() {
    const filterItems = Array.from(document.querySelectorAll("[data-filter-item]"));

    filterItems.forEach((item) => {
      const status = item.dataset.status || "open";
      const focuses = (item.dataset.focuses || "").split(" ").filter(Boolean);
      const matchesStatus = activeStatusFilter === "all" || status === activeStatusFilter;
      const matchesFocus = activeFocusFilter === "all" || focuses.includes(activeFocusFilter);
      item.hidden = !(matchesStatus && matchesFocus);
    });

    tabTriggers.forEach((trigger) => {
      const tabId = trigger.dataset.tabTrigger;
      const countNode = trigger.querySelector(".tab-count");
      const panel = tabId
        ? document.querySelector(`[data-tab-panel="${tabId}"]`)
        : null;

      if (!(countNode instanceof HTMLElement) || !(panel instanceof HTMLElement)) {
        return;
      }

      const visibleCount = Array.from(panel.querySelectorAll("[data-filter-item]")).filter(
        (item) => !item.hasAttribute("hidden"),
      ).length;

      countNode.textContent = String(visibleCount);
    });
  }

  function activateFilter(buttons, targetValue, activeClassName) {
    buttons.forEach((button) => {
      const currentValue =
        button.dataset.statusFilter || button.dataset.focusFilter || "";
      button.classList.toggle(activeClassName, currentValue === targetValue);
    });
  }

  function revealFirstVisibleItem() {
    const activePanel = tabPanels.find((panel) => !panel.hidden);
    const firstVisibleItem = activePanel
      ? Array.from(activePanel.querySelectorAll("[data-filter-item]")).find((item) => !item.hidden)
      : undefined;

    if (firstVisibleItem instanceof HTMLElement) {
      firstVisibleItem.scrollIntoView({ block: "start", behavior: "auto" });
    }
  }

  function getActivePanel() {
    return tabPanels.find((panel) => !panel.hidden);
  }

  function parseCompetitionDate(rawValue) {
    if (!rawValue) {
      return Number.POSITIVE_INFINITY;
    }

    const chineseDateMatch = rawValue.match(/(\d{4})年\s*(\d{1,2})月\s*(\d{1,2})日/);
    if (chineseDateMatch) {
      return Date.UTC(
        Number(chineseDateMatch[1]),
        Number(chineseDateMatch[2]) - 1,
        Number(chineseDateMatch[3]),
      );
    }

    const normalizedValue = rawValue
      .replace(/\./g, "")
      .replace(/\u00a0/g, " ")
      .trim()
      .toLowerCase();

    const monthLookup = {
      jan: 0,
      january: 0,
      fev: 1,
      feb: 1,
      february: 1,
      mar: 2,
      march: 2,
      abr: 3,
      apr: 3,
      april: 3,
      mai: 4,
      may: 4,
      jun: 5,
      june: 5,
      jul: 6,
      july: 6,
      ago: 7,
      aug: 7,
      august: 7,
      set: 8,
      sep: 8,
      sept: 8,
      september: 8,
      out: 9,
      oct: 9,
      october: 9,
      nov: 10,
      november: 10,
      dez: 11,
      dec: 11,
      december: 11,
    };

    const monthFirstMatch = normalizedValue.match(/^([a-z]+)\s+(\d{1,2}),?\s+(\d{4})$/);
    if (monthFirstMatch) {
      const monthIndex = monthLookup[monthFirstMatch[1]];
      if (monthIndex !== undefined) {
        return Date.UTC(Number(monthFirstMatch[3]), monthIndex, Number(monthFirstMatch[2]));
      }
    }

    const dayFirstMatch = normalizedValue.match(/^(\d{1,2})\s+([a-z]+)\s+(\d{4})$/);
    if (dayFirstMatch) {
      const monthIndex = monthLookup[dayFirstMatch[2]];
      if (monthIndex !== undefined) {
        return Date.UTC(Number(dayFirstMatch[3]), monthIndex, Number(dayFirstMatch[1]));
      }
    }

    const parsedTimestamp = Date.parse(rawValue);
    return Number.isFinite(parsedTimestamp) ? parsedTimestamp : Number.POSITIVE_INFINITY;
  }

  function parsePrizeValue(rawValue) {
    if (!rawValue) {
      return 0;
    }

    const priceMatch = rawValue
      .replace(/,/g, "")
      .toUpperCase()
      .match(/\$?\s*([0-9]+(?:\.[0-9]+)?)\s*([KM]?)/);

    if (!priceMatch) {
      return 0;
    }

    const baseValue = Number(priceMatch[1]);
    const multiplier = priceMatch[2] === "M" ? 1_000_000 : priceMatch[2] === "K" ? 1_000 : 1;

    return baseValue * multiplier;
  }

  function readCardDeadline(card) {
    const deadlineValue = card.querySelector(".ccard-deadline strong");
    return parseCompetitionDate(deadlineValue?.textContent?.trim() || "");
  }

  function readCardPrize(card) {
    const prizeValue = card.querySelector(".ccard-prize");
    return parsePrizeValue(prizeValue?.textContent?.trim() || "");
  }

  function sortActivePanelCards() {
    if (!(competitionSortSelect instanceof HTMLSelectElement)) {
      return;
    }

    const activePanel = getActivePanel();
    const grid = activePanel?.querySelector(".comp-grid");
    if (!(activePanel instanceof HTMLElement) || !(grid instanceof HTMLElement)) {
      return;
    }

    const cardElements = Array.from(grid.children).filter(
      (child) => child instanceof HTMLElement && child.hasAttribute("data-filter-item"),
    );
    const auxiliaryElements = Array.from(grid.children).filter(
      (child) => child instanceof HTMLElement && !child.hasAttribute("data-filter-item"),
    );

    if (cardElements.length === 0) {
      return;
    }

    const originalOrder = new Map(cardElements.map((card, index) => [card, index]));
    const visibleCards = cardElements.filter((card) => !card.hidden);
    const hiddenCards = cardElements.filter((card) => card.hidden);
    const sortedVisibleCards = [...visibleCards];

    if (competitionSortSelect.selectedIndex === 0) {
      sortedVisibleCards.sort((left, right) => {
        const dateDifference = readCardDeadline(left) - readCardDeadline(right);
        return dateDifference || (originalOrder.get(left) ?? 0) - (originalOrder.get(right) ?? 0);
      });
    } else if (competitionSortSelect.selectedIndex === 1) {
      sortedVisibleCards.sort((left, right) => {
        const prizeDifference = readCardPrize(right) - readCardPrize(left);
        return prizeDifference || (originalOrder.get(left) ?? 0) - (originalOrder.get(right) ?? 0);
      });
    } else if (competitionSortSelect.selectedIndex === 2) {
      sortedVisibleCards.reverse();
    }

    grid.replaceChildren(...sortedVisibleCards, ...hiddenCards, ...auxiliaryElements);
  }

  tabTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      activateTab(trigger.dataset.tabTrigger);
      sortActivePanelCards();
    });
  });

  statusFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeStatusFilter = button.dataset.statusFilter || "all";
      activateFilter(statusFilterButtons, activeStatusFilter, "is-active");
      applyFilters();
      sortActivePanelCards();
      if (activeStatusFilter !== "all" && activeFocusFilter !== "all") {
        revealFirstVisibleItem();
      }
    });
  });

  focusFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFocusFilter = button.dataset.focusFilter || "all";
      activateFilter(focusFilterButtons, activeFocusFilter, "is-active");
      applyFilters();
      sortActivePanelCards();
      if (activeStatusFilter !== "all" && activeFocusFilter !== "all") {
        revealFirstVisibleItem();
      }
    });
  });

  if (competitionSortSelect instanceof HTMLSelectElement) {
    competitionSortSelect.addEventListener("change", () => {
      sortActivePanelCards();
    });
  }

  applyFilters();
  sortActivePanelCards();

  // Activate tab from URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const tabParam = urlParams.get("tab");
  if (tabParam) {
    const matchingTrigger = tabTriggers.find(
      (trigger) => trigger.dataset.tabTrigger === tabParam
    );
    if (matchingTrigger) {
      activateTab(tabParam);
      applyFilters();
      sortActivePanelCards();
    }
  }
</script>
