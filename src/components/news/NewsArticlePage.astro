---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";

import type { HomepageLocaleCode, SiteSettings } from "../../lib/homepage/types";
import type { NewsArticleRouteLocale } from "../../lib/news/types";

interface Props {
  locale: NewsArticleRouteLocale;
  siteSettings: SiteSettings;
  currentLanguage: HomepageLocaleCode;
}

const { locale, siteSettings, currentLanguage } = Astro.props;
---

<div class="interior-page">
  <InteriorHeader
    navItems={locale.navItems}
    activeHref="/news/"
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
    languageLabel={locale.ui.chooseLanguage}
    homeLabel={locale.ui.homeLabel}
    menuLabel={locale.ui.menu}
    desktopMenuSections={locale.desktopMenuSections}
    navExploreLabel={locale.navExploreLabel}
  />

  <main>
    <section class="page-header news-article-header">
      <div class="interior-wrap">
        <a href="/news/" class="news-back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          <span data-i18n="articlePage.backLabel">{locale.articlePage.backLabel}</span>
        </a>

        <div
          class:list={[
            "news-card-tag",
            locale.page.tag.trim().toLowerCase() === "report" ? null : "news-card-tag--muted",
          ]}
          data-i18n="page.tag"
          data-tag-type={locale.page.tag.trim().toLowerCase()}
        >
          {locale.page.tag}
        </div>

        <h1 class="page-title news-article-title" data-i18n="page.title">{locale.page.title}</h1>

        <div class="news-article-meta-row news-article-meta-row--below">
          <div class="news-inline-meta">
            <span>
              <span data-i18n="articlePage.publishedLabel">{locale.articlePage.publishedLabel}</span>{" "}
              <strong data-i18n="page.publishedDateText">{locale.page.publishedDateText}</strong>
            </span>
            <span>
              <span data-i18n="articlePage.writtenByLabel">{locale.articlePage.writtenByLabel}</span>{" "}
              <strong>{locale.page.author}</strong>
            </span>
            <span>
              <strong>{locale.page.readTimeMinutes}</strong>{" "}
              <span data-i18n="articlePage.readingTimeLabel">{locale.articlePage.readingTimeLabel}</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="interior-wrap news-article-shell">
      <div
        class="news-article-hero-image"
        role="img"
        aria-label={locale.page.imageAlt}
        data-i18n-aria-label="page.imageAlt"
        style={`background-image:url('${locale.page.image}')`}
      ></div>

      <article class="news-article-body" data-i18n-html="page.bodyHtml" set:html={locale.page.bodyHtml}></article>

      {locale.relatedArticles.length > 0 && (
        <section class="news-related-shell">
          <div class="news-grid-header news-grid-header--article">
            <h2 data-i18n="articlePage.moreInsightsLabel">{locale.articlePage.moreInsightsLabel}</h2>
            <a href="/news/" class="news-list-link news-list-link--muted" data-i18n="articlePage.allInsightsLabel">
              {locale.articlePage.allInsightsLabel}
            </a>
          </div>

          <div class="news-list-grid news-list-grid--compact">
            {locale.relatedArticles.map((item, index) => (
              <a href={item.href} class="news-list-card news-list-card--compact">
                <div class="news-list-card-inner">
                  <div class="news-card-copy">
                    <div
                      class:list={[
                        "news-card-tag",
                        item.tag.trim().toLowerCase() === "report" ? null : "news-card-tag--muted",
                      ]}
                      data-i18n={`relatedArticles.${index}.tag`}
                      data-tag-type={item.tag.trim().toLowerCase()}
                    >
                      {item.tag}
                    </div>
                    <h3 class="news-card-title" data-i18n={`relatedArticles.${index}.title`}>{item.title}</h3>
                    <p class="news-card-summary" data-i18n={`relatedArticles.${index}.summary`}>
                      {item.summary}
                    </p>
                  </div>

                  <div
                    class="news-card-media"
                    role="img"
                    aria-label={item.imageAlt}
                    data-i18n-aria-label={`relatedArticles.${index}.imageAlt`}
                  >
                    <div class="news-card-media-layer" style={`background-image:url('${item.image}')`}></div>
                    <div
                      class="news-card-media-layer news-card-media-layer--hover"
                      style={`background-image:url('${item.hoverImage}')`}
                    ></div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </section>
  </main>

  <InteriorFooter
    footer={locale.footer}
    ui={locale.ui}
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
  />
</div>
