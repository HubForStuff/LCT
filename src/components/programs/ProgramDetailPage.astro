---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";

import type { HomepageLocaleCode, SiteSettings } from "../../lib/homepage/types";
import type { ProgramDetailRouteLocale } from "../../lib/programs/types";

interface Props {
  locale: ProgramDetailRouteLocale;
  siteSettings: SiteSettings;
  currentLanguage: HomepageLocaleCode;
}

const { locale, siteSettings, currentLanguage } = Astro.props;
const { page, detail } = locale;
---

<div class="interior-page">
  <InteriorHeader
    navItems={locale.navItems}
    activeHref={page.listingHref}
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
    languageLabel={locale.ui.chooseLanguage}
    homeLabel={locale.ui.homeLabel}
    menuLabel={locale.ui.menu}
    desktopMenuSections={locale.desktopMenuSections}
    navExploreLabel={locale.navExploreLabel}
  />

  <main>
    <section class="page-header program-detail-header">
      <div class="interior-wrap program-detail-header-inner">
        <a href={page.listingHref} class="news-back-link news-back-link--muted">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          <span data-i18n="detail.backLabel">{detail.backLabel}</span>
        </a>

        <div class="program-detail-intro">
          <div class="page-eyebrow" data-i18n="page.detailEyebrow">
            <span class="dot"></span>
            {page.detailEyebrow}
          </div>
          <h1 class="page-title program-detail-title" data-i18n="page.name">{page.name}</h1>
          <p
            class="page-subtitle page-subtitle--wide"
            data-i18n="page.detailSubtitle"
          >
            {page.detailSubtitle}
          </p>
        </div>
      </div>
    </section>

    {page.detailImage && (
      <div class="interior-wrap">
        <div
          class="program-detail-hero-image"
          role="img"
          aria-label={page.name}
          style={`background-image:url('${page.detailImage}')`}
        ></div>
      </div>
    )}

    <section class="interior-wrap program-detail-shell">
      <div class="competition-meta-grid program-meta-grid">
        <article class="competition-meta-card">
          <div class="competition-meta-label" data-i18n="detail.timelineLabel">
            {detail.timelineLabel}
          </div>
          <div class="competition-meta-value">
            <span data-i18n="page.deadlinePrefix">{page.deadlinePrefix}</span>{" "}
            <strong data-i18n="page.deadlineValue">{page.deadlineValue}</strong>
          </div>
        </article>

        <article class="competition-meta-card">
          <div class="competition-meta-label" data-i18n="detail.focusLabel">
            {detail.focusLabel}
          </div>
          <div class="competition-focus-tags">
            {page.focusTags.map((tag) => (
              <span class="competition-focus-tag">{tag}</span>
            ))}
          </div>
        </article>

        <article class="competition-meta-card">
          <div class="competition-meta-label" data-i18n="detail.statusLabel">
            {detail.statusLabel}
          </div>
          <div class:list={["competition-meta-value", `competition-meta-value--${page.statusTone}`]}>
            <span data-i18n="page.statusLabel">{page.statusLabel}</span>
          </div>
        </article>
      </div>

      <article
        class="static-page-body static-page-body--plain"
        data-i18n-html="page.bodyHtml"
        set:html={page.bodyHtml}
      ></article>
    </section>

    <div class="interior-wrap competition-detail-actions competition-detail-actions--center">
      <a
        href={page.applicationHref}
        class="site-btn site-btn--primary"
        data-i18n="page.applicationLabel"
      >
        {page.applicationLabel}
      </a>
      <a href={page.listingHref} class="site-btn site-btn--secondary" data-i18n="detail.viewAllLabel">
        {detail.viewAllLabel}
      </a>
    </div>
  </main>

  <InteriorFooter
    footer={locale.footer}
    ui={locale.ui}
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
  />
</div>
