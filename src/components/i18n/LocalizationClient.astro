---
import type { HomepageLocaleCode } from "../../lib/homepage/types";

interface Props {
  defaultLanguage: HomepageLocaleCode;
  localizedContent: Record<HomepageLocaleCode, unknown>;
}

const { defaultLanguage, localizedContent } = Astro.props;
---

<script
  id="localized-content"
  type="application/json"
  data-default-language={defaultLanguage}
  set:html={JSON.stringify(localizedContent)}
></script>

<script is:inline>
  const localizationScript = document.getElementById("localized-content");
  const localizedContent = localizationScript ? JSON.parse(localizationScript.textContent || "{}") : {};
  const defaultLanguage = localizationScript?.dataset.defaultLanguage || "EN";
  const languageMenuSelector = ".desk-footer-lang, .site-lang";

  const validLanguage = (code) => (localizedContent[code] ? code : defaultLanguage);

  const resolveTranslation = (code, path) =>
    path.split(".").reduce((value, segment) => {
      if (value === undefined || value === null) {
        return value;
      }

      return /^\d+$/.test(segment) ? value[Number(segment)] : value[segment];
    }, localizedContent[code]);

  const setActiveLanguage = (code) => {
    document.querySelectorAll("[data-lang-option]").forEach((option) => {
      option.classList.toggle("is-active", option.dataset.langOption === code);
    });
    document.querySelectorAll("[data-lang-active-code]").forEach((el) => {
      el.textContent = code;
    });
  };

  const closeLanguageMenus = () => {
    document.querySelectorAll(`${languageMenuSelector}.is-open`).forEach((menu) => {
      menu.classList.remove("is-open");
      menu.querySelector("[data-lang-toggle]")?.setAttribute("aria-expanded", "false");
    });
  };

  const applyLanguage = (code) => {
    const language = validLanguage(code);
    const content = localizedContent[language];

    document.documentElement.lang = content.meta.htmlLang;
    document.title = content.meta.title;
    document
      .querySelector('meta[name="description"]')
      ?.setAttribute("content", content.meta.description);

    document.querySelectorAll("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n");
      if (!key) {
        return;
      }

      const value = resolveTranslation(language, key);
      if (typeof value === "string") {
        element.textContent = value;
      }
    });

    document.querySelectorAll("[data-i18n-html]").forEach((element) => {
      const key = element.getAttribute("data-i18n-html");
      if (!key) {
        return;
      }

      const value = resolveTranslation(language, key);
      if (typeof value === "string") {
        element.innerHTML = value;
      }
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
      const key = element.getAttribute("data-i18n-placeholder");
      if (!key) {
        return;
      }

      const value = resolveTranslation(language, key);
      if (typeof value === "string") {
        element.setAttribute("placeholder", value);
      }
    });

    document.querySelectorAll("[data-i18n-aria-label]").forEach((element) => {
      const key = element.getAttribute("data-i18n-aria-label");
      if (!key) {
        return;
      }

      const value = resolveTranslation(language, key);
      if (typeof value === "string") {
        element.setAttribute("aria-label", value);
      }
    });

    setActiveLanguage(language);
    window.localStorage.setItem("preferredLanguage", language);
  };

  const storedLanguage = window.localStorage.getItem("preferredLanguage");
  applyLanguage(validLanguage(storedLanguage || defaultLanguage));

  document.querySelectorAll("[data-lang-option]").forEach((option) => {
    option.addEventListener("click", () => {
      applyLanguage(option.dataset.langOption || defaultLanguage);
      closeLanguageMenus();
      document.getElementById("mobileLangSheet")?.classList.remove("is-open");
      document.getElementById("mobileLangOverlay")?.classList.remove("is-open");
    });
  });

  document.querySelectorAll("[data-lang-toggle]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const container = button.closest(languageMenuSelector);
      const isOpen = container?.classList.contains("is-open");
      closeLanguageMenus();
      if (!isOpen && container) {
        container.classList.add("is-open");
        button.setAttribute("aria-expanded", "true");
      }
    });
  });

  document.addEventListener("click", () => {
    closeLanguageMenus();
  });

  const mobileMenu = document.getElementById("mobileMenu");
  const mobileMenuBtn = document.getElementById("mobileMenuBtn");
  const mobileLangBtn = document.getElementById("mobileLangBtn");
  const mobileLangSheet = document.getElementById("mobileLangSheet");
  const mobileLangOverlay = document.getElementById("mobileLangOverlay");
  const mobileWechatBtn = document.getElementById("mobileWechatBtn");
  const mobileWechatOverlay = document.getElementById("mobileWechatOverlay");
  const mobileWechatClose = document.getElementById("mobileWechatClose");
  const mobileHomeNav = document.querySelector(".mobile-home .mob-nav");
  let lastMobileScrollY = window.scrollY;

  const updateMobileHomeNavTransparency = () => {
    if (!mobileHomeNav) {
      return;
    }

    const currentScrollY = window.scrollY;
    const scrollingDown = currentScrollY > lastMobileScrollY;
    const isOverlayOpen =
      mobileMenu?.classList.contains("is-open") ||
      mobileLangSheet?.classList.contains("is-open") ||
      mobileWechatOverlay?.classList.contains("is-open");

    mobileHomeNav.classList.toggle(
      "is-scroll-transparent",
      currentScrollY > 24 && scrollingDown && !isOverlayOpen,
    );
    lastMobileScrollY = currentScrollY;
  };

  if (mobileHomeNav) {
    window.addEventListener("scroll", updateMobileHomeNavTransparency, { passive: true });
    updateMobileHomeNavTransparency();
  }

  mobileMenuBtn?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("is-open");
    mobileMenu?.classList.toggle("is-open", isOpen);
    mobileMenuBtn.classList.toggle("is-open", isOpen);
    mobileMenuBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    updateMobileHomeNavTransparency();
  });

  mobileLangBtn?.addEventListener("click", () => {
    mobileLangSheet?.classList.add("is-open");
    mobileLangOverlay?.classList.add("is-open");
    updateMobileHomeNavTransparency();
  });

  mobileLangOverlay?.addEventListener("click", () => {
    mobileLangSheet?.classList.remove("is-open");
    mobileLangOverlay.classList.remove("is-open");
    updateMobileHomeNavTransparency();
  });

  document.querySelectorAll("[data-mobile-accordion]").forEach((button) => {
    button.addEventListener("click", () => {
      const item = button.closest(".mob-menu-item");
      const isOpen = item?.classList.contains("is-open");
      document.querySelectorAll(".mob-menu-item.is-open").forEach((openItem) => {
        if (openItem !== item) {
          openItem.classList.remove("is-open");
          openItem.querySelector("[data-mobile-accordion]")?.setAttribute("aria-expanded", "false");
        }
      });
      item?.classList.toggle("is-open", !isOpen);
      button.setAttribute("aria-expanded", !isOpen ? "true" : "false");
    });
  });

  mobileWechatBtn?.addEventListener("click", () => {
    mobileWechatOverlay?.classList.add("is-open");
    updateMobileHomeNavTransparency();
  });

  mobileWechatClose?.addEventListener("click", () => {
    mobileWechatOverlay?.classList.remove("is-open");
    updateMobileHomeNavTransparency();
  });

  mobileWechatOverlay?.addEventListener("click", (event) => {
    if (event.target === mobileWechatOverlay) {
      mobileWechatOverlay.classList.remove("is-open");
      updateMobileHomeNavTransparency();
    }
  });

  const revealEls = document.querySelectorAll(".mob-reveal");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18 }
    );

    revealEls.forEach((element) => observer.observe(element));
  } else {
    revealEls.forEach((element) => element.classList.add("is-visible"));
  }
</script>
