---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";
import Icon from "../site/Icon.astro";

import type { HomepageLocaleCode, SiteSettings } from "../../lib/homepage/types";
import type { CompetitionFormRouteLocale } from "../../lib/competitions/types";
import { PREREG_ENDPOINT, AI_ASSISTANCE_ENABLED } from "../../lib/pre-registration/config";

interface Props {
  locale: CompetitionFormRouteLocale;
  siteSettings: SiteSettings;
  currentLanguage: HomepageLocaleCode;
}

const { locale, siteSettings, currentLanguage } = Astro.props;
const page = locale.page;
const competitionOptions = locale.competitionOptions;
const applicationModeEntries = Object.entries(page.applicationModes);
const defaultApplicationMode = page.defaultApplicationMode;
const defaultApplicationModeCopy = page.applicationModes[defaultApplicationMode];

const aiTextareaFields = [
  {
    id: "projectOverview",
    label: page.fields.projectOverview,
    labelKey: "page.fields.projectOverview",
    placeholder: page.fields.projectOverviewPlaceholder,
    placeholderKey: "page.fields.projectOverviewPlaceholder",
  },
  {
    id: "productFeatures",
    label: page.fields.productFeatures,
    labelKey: "page.fields.productFeatures",
    placeholder: page.fields.productFeaturesPlaceholder,
    placeholderKey: "page.fields.productFeaturesPlaceholder",
  },
  {
    id: "businessModel",
    label: page.fields.businessModel,
    labelKey: "page.fields.businessModel",
    placeholder: page.fields.businessModelPlaceholder,
    placeholderKey: "page.fields.businessModelPlaceholder",
  },
  {
    id: "teamIntroduction",
    label: page.fields.teamIntroduction,
    labelKey: "page.fields.teamIntroduction",
    placeholder: page.fields.teamIntroductionPlaceholder,
    placeholderKey: "page.fields.teamIntroductionPlaceholder",
  },
  {
    id: "investmentValue",
    label: page.fields.investmentValue,
    labelKey: "page.fields.investmentValue",
    placeholder: page.fields.investmentValuePlaceholder,
    placeholderKey: "page.fields.investmentValuePlaceholder",
  },
  {
    id: "fundingAmountRequested",
    label: page.fields.fundingAmountRequested,
    labelKey: "page.fields.fundingAmountRequested",
    placeholder: page.fields.fundingAmountRequestedPlaceholder,
    placeholderKey: "page.fields.fundingAmountRequestedPlaceholder",
  },
] as const;
---

<div class="interior-page">
  <InteriorHeader
    navItems={locale.navItems}
    activeHref="/competitions/"
    siteSettings={siteSettings}
    currentLanguage={currentLanguage}
    languageLabel={locale.ui.chooseLanguage}
    homeLabel={locale.ui.homeLabel}
    menuLabel={locale.ui.menu}
    desktopMenuSections={locale.desktopMenuSections}
    navExploreLabel={locale.navExploreLabel}
  />

  <main>
    <section class="page-header">
      <div class="interior-wrap page-header-inner page-header-inner--split">
        <div>
          <div class="page-eyebrow">
            <span class="dot page-status-dot"></span>
            <span
              data-prereg-page-eyebrow
              data-i18n={`page.applicationModes.${defaultApplicationMode}.statusLabel`}
            >
              {defaultApplicationModeCopy.statusLabel}
            </span>
          </div>
          <h1
            class="page-title"
            data-prereg-page-title
            data-i18n-html="page.titleHtml"
            set:html={page.titleHtml}
          ></h1>
          <p class="selected-competition-context" data-selected-competition-context hidden>
            <span data-i18n="page.fields.selectedCompetition">{page.fields.selectedCompetition}</span>
            <strong data-selected-competition-name></strong>
          </p>
        </div>
        <p class="page-subtitle" data-prereg-page-subtitle data-i18n="page.subtitle">{page.subtitle}</p>
        <span
          class="sr-only"
          data-prereg-default-application-mode
        >
          {defaultApplicationMode}
        </span>
        {applicationModeEntries.map(([mode, copy]) => (
          <span class="sr-only" data-prereg-mode-copy={mode}>
            <span
              data-prereg-mode-status-label
              data-i18n={`page.applicationModes.${mode}.statusLabel`}
            >
              {copy.statusLabel}
            </span>
            <span
              data-prereg-mode-title-suffix
              data-i18n={`page.applicationModes.${mode}.titleSuffix`}
            >
              {copy.titleSuffix}
            </span>
            <span
              data-prereg-mode-selected-subtitle-template
              data-i18n={`page.applicationModes.${mode}.selectedSubtitleTemplate`}
            >
              {copy.selectedSubtitleTemplate}
            </span>
            <span
              data-prereg-mode-banner-badge
              data-i18n={`page.applicationModes.${mode}.bannerBadge`}
            >
              {copy.bannerBadge}
            </span>
            <span
              data-prereg-mode-banner-title
              data-i18n={`page.applicationModes.${mode}.bannerTitle`}
            >
              {copy.bannerTitle}
            </span>
          </span>
        ))}
      </div>
    </section>

    <section class="interior-wrap pre-registration-shell">
      <div class="prereg-banner">
        <div class="prereg-banner-copy">
          <div
            class="prereg-banner-badge"
            data-prereg-banner-badge
            data-i18n={`page.applicationModes.${defaultApplicationMode}.bannerBadge`}
          >
            {defaultApplicationModeCopy.bannerBadge}
          </div>
          <h2
            data-prereg-banner-title
            data-i18n={`page.applicationModes.${defaultApplicationMode}.bannerTitle`}
          >
            {defaultApplicationModeCopy.bannerTitle}
          </h2>
          <p data-i18n-html="page.banner.descriptionHtml" set:html={page.banner.descriptionHtml}></p>
        </div>
      </div>

      <div class="tutorial-area">
        <div class="tutorial-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>

        <div class="tutorial-body">
          <h2 data-i18n="page.guide.title">{page.guide.title}</h2>
          <p data-i18n="page.guide.description">{page.guide.description}</p>
        </div>

        <div class="tutorial-actions">
          {page.guide.actions.map((action, actionIndex) => (
            action.href === "#" ? (
              <button
                type="button"
                class:list={[
                  "site-btn",
                  action.theme === "dark" ? "site-btn--dark" : "site-btn--secondary",
                  "site-btn--disabled",
                ]}
                disabled
              >
                <span class="resource-icon" aria-hidden="true">
                  {action.icon === "download" ? "↓" : "▶"}
                </span>
                <span data-i18n={`page.guide.actions.${actionIndex}.label`}>{action.label}</span>
              </button>
            ) : (
              <a
                href={action.href}
                class:list={[
                  "site-btn",
                  action.theme === "dark" ? "site-btn--dark" : "site-btn--secondary",
                ]}
              >
                <span class="resource-icon" aria-hidden="true">
                  {action.icon === "download" ? "↓" : "▶"}
                </span>
                <span data-i18n={`page.guide.actions.${actionIndex}.label`}>{action.label}</span>
              </a>
            )
          ))}
        </div>
      </div>

      <div
        class="form-progress"
        aria-label={page.formProgressLabel}
        data-i18n-aria-label="page.formProgressLabel"
      >
        {page.progressSteps.map((step, stepIndex) => (
          <a
            href={`#${step.target}`}
            class:list={["progress-step", stepIndex === 0 && "is-active"]}
          >
            <span class="progress-step-number">{step.number}</span>
            <span data-i18n={`page.progressSteps.${stepIndex}.label`}>{step.label}</span>
          </a>
        ))}
      </div>

      <div class="form-wrap">
        <form class="pre-reg-form" method="post" enctype="multipart/form-data" data-prereg-form data-endpoint={PREREG_ENDPOINT}>
          <input type="checkbox" class="prereg-honeypot" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <section class="form-section" id="section-1">
            <div class="form-section-header">
              <div class="form-section-number">1</div>
              <div>
                <h2 class="form-section-title" data-i18n="page.sections.competitionInformationTitle">
                  {page.sections.competitionInformationTitle}
                </h2>
                <p class="form-section-subtitle" data-i18n="page.sections.competitionInformationSubtitle">
                  {page.sections.competitionInformationSubtitle}
                </p>
              </div>
            </div>

            <div class="form-row" data-competition-select-row>
              <label for="selectedCompetition">
                <span data-i18n="page.fields.selectedCompetition">{page.fields.selectedCompetition}</span>{" "}
                <span class="req">*</span>
              </label>
              <select id="selectedCompetition" name="selectedCompetition" data-competition-select>
                <option value="" disabled selected data-i18n="page.fields.selectedCompetitionPlaceholder">
                  {page.fields.selectedCompetitionPlaceholder}
                </option>
                {competitionOptions.map((option, optionIndex) => (
                  <option
                    value={option.slug}
                    data-application-mode={option.applicationMode}
                    data-i18n={`competitionOptions.${optionIndex}.label`}
                  >
                    {option.label}
                  </option>
                ))}
              </select>
              <input type="hidden" name="competitionSlug" data-competition-hidden />
            </div>

            <div class="form-row">
              <label for="projectName">
                <span data-i18n="page.fields.projectName">{page.fields.projectName}</span> <span class="req">*</span>
              </label>
              <input
                id="projectName"
                name="projectName"
                type="text"
                placeholder={page.fields.projectNamePlaceholder}
                data-i18n-placeholder="page.fields.projectNamePlaceholder"
              />
            </div>

            <div class="form-row">
              <label for="projectIntro">
                <span data-i18n="page.fields.projectIntroduction">{page.fields.projectIntroduction}</span>{" "}
                <span class="req">*</span>{" "}
                <span class="hint" data-i18n="page.fields.projectIntroductionHint">
                  {page.fields.projectIntroductionHint}
                </span>
              </label>
              <div class="field-wrap">
                <textarea
                  id="projectIntro"
                  name="projectIntro"
                  rows="4"
                  class="has-ai"
                  placeholder={page.fields.projectIntroductionPlaceholder}
                  data-i18n-placeholder="page.fields.projectIntroductionPlaceholder"
                ></textarea>
              </div>
              <div class="word-count" data-i18n="page.wordCountTarget">{page.wordCountTarget}</div>
            </div>

            <div class="form-row">
              <label for="deckFile">
                <span data-i18n="page.fields.pitchingDeck">{page.fields.pitchingDeck}</span>{" "}
                <span class="req">*</span>{" "}
                <span class="hint" data-i18n="page.fields.pitchingDeckHint">
                  {page.fields.pitchingDeckHint}
                </span>
              </label>
              <label class="file-upload-area" for="deckFile">
                <input id="deckFile" name="deckFile" type="file" accept=".pdf,.ppt,.pptx" data-deck-file-input />
                <span class="file-upload-icon">↑</span>
                <span class="file-upload-label" data-i18n="page.fields.pitchingDeckUploadLabel">{page.fields.pitchingDeckUploadLabel}</span>
                <span class="file-upload-sub" data-i18n="page.fields.pitchingDeckUploadSubtext">{page.fields.pitchingDeckUploadSubtext}</span>
                <span class="file-upload-selected" data-deck-file-status hidden></span>
              </label>
            </div>

            <div class="form-row">
              <label for="deckLink">
                <span data-i18n="page.deckLinkLabel">{page.deckLinkLabel}</span>{" "}
                <span class="hint" data-i18n="page.deckLinkHint">{page.deckLinkHint}</span>
              </label>
              <input id="deckLink" name="deckLink" type="url" placeholder={page.deckLinkPlaceholder} data-i18n-placeholder="page.deckLinkPlaceholder" />
            </div>

            {AI_ASSISTANCE_ENABLED && (
              <div class="form-row ai-assistance-panel" data-ai-assistance-panel>
                <button type="button" class="site-btn site-btn--dark" data-ai-assistance-button data-i18n="page.aiAssistance.buttonLabel" disabled>
                  {page.aiAssistance.buttonLabel}
                </button>
                <p class="ai-assistance-disclosure" data-i18n="page.aiAssistance.disclosure">{page.aiAssistance.disclosure}</p>
                <p class="form-status" data-ai-assistance-status role="status" aria-live="polite"></p>
              </div>
            )}

            <div class="form-row">
              <label for="compField">
                <span data-i18n="page.fields.competitionField">{page.fields.competitionField}</span>{" "}
                <span class="req">*</span>
              </label>
              <select id="compField" name="compField">
                <option value="" disabled selected data-i18n="page.fields.competitionFieldPlaceholder">
                  {page.fields.competitionFieldPlaceholder}
                </option>
                {page.competitionFieldOptions.map((option, optionIndex) => (
                  <option value={option} data-i18n={`page.competitionFieldOptions.${optionIndex}`}>
                    {option}
                  </option>
                ))}
              </select>
            </div>

            <div class="form-row">
              <span class="label-like">
                <span data-i18n="page.fields.companyHeadquarters">{page.fields.companyHeadquarters}</span>{" "}
                <span class="req">*</span>
              </span>
              <div class="radio-group">
                {page.companyHeadquartersOptions.map((option, optionIndex) => (
                  <label class="radio-pill">
                    <input
                      type="radio"
                      name="companyHeadquarters"
                      value={option}
                    />
                    <span data-i18n={`page.companyHeadquartersOptions.${optionIndex}`}>{option}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <label for="compLocation">
                <span data-i18n="page.fields.companyLocation">{page.fields.companyLocation}</span>{" "}
                <span class="req">*</span>
              </label>
              <input
                id="compLocation"
                name="compLocation"
                type="text"
                placeholder={page.fields.companyLocationPlaceholder}
                data-i18n-placeholder="page.fields.companyLocationPlaceholder"
              />
            </div>

            <div class="form-row">
              <label for="compFullName">
                <span data-i18n="page.fields.companyFullName">{page.fields.companyFullName}</span>{" "}
                <span class="req">*</span>
              </label>
              <input
                id="compFullName"
                name="compFullName"
                type="text"
                required
                placeholder={page.fields.companyFullNamePlaceholder}
                data-i18n-placeholder="page.fields.companyFullNamePlaceholder"
              />
            </div>

            <div class="form-row">
              <label for="officeAddress">
                <span data-i18n="page.fields.officeAddress">{page.fields.officeAddress}</span>
              </label>
              <input
                id="officeAddress"
                name="officeAddress"
                type="text"
                placeholder={page.fields.officeAddressPlaceholder}
                data-i18n-placeholder="page.fields.officeAddressPlaceholder"
              />
            </div>
          </section>

          <section class="form-section" id="section-2">
            <div class="form-section-header">
              <div class="form-section-number">2</div>
              <div>
                <h2 class="form-section-title" data-i18n="page.sections.applicantTitle">
                  {page.sections.applicantTitle}
                </h2>
                <p class="form-section-subtitle" data-i18n="page.sections.applicantSubtitle">
                  {page.sections.applicantSubtitle}
                </p>
              </div>
            </div>

            <div class="form-note" data-i18n="page.notes.applicant">{page.notes.applicant}</div>

            <div class="form-row form-row--split">
              <div>
                <label for="applicantName">
                  <span data-i18n="page.fields.fullName">{page.fields.fullName}</span> <span class="req">*</span>
                </label>
                <input
                  id="applicantName"
                  name="applicantName"
                  type="text"
                  placeholder={page.fields.fullNamePlaceholder}
                  data-i18n-placeholder="page.fields.fullNamePlaceholder"
                />
              </div>
              <div>
                <span class="label-like">
                  <span data-i18n="page.fields.gender">{page.fields.gender}</span> <span class="req">*</span>
                </span>
                <div class="radio-group">
                  {page.genderOptions.map((option, optionIndex) => (
                    <label class="radio-pill">
                      <input type="radio" name="gender" value={option} />
                      <span data-i18n={`page.genderOptions.${optionIndex}`}>{option}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="dob">
                  <span data-i18n="page.fields.dateOfBirth">{page.fields.dateOfBirth}</span>{" "}
                  <span class="req">*</span>
                </label>
                <input id="dob" name="dob" type="date" />
              </div>
              <div>
                <label for="nationality">
                  <span data-i18n="page.fields.nationality">{page.fields.nationality}</span>{" "}
                  <span class="req">*</span>
                </label>
                <input
                  id="nationality"
                  name="nationality"
                  type="text"
                  placeholder={page.fields.nationalityPlaceholder}
                  data-i18n-placeholder="page.fields.nationalityPlaceholder"
                />
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="university">
                  <span data-i18n="page.fields.graduationInstitution">
                    {page.fields.graduationInstitution}
                  </span>{" "}
                  <span class="req">*</span>
                </label>
                <input
                  id="university"
                  name="university"
                  type="text"
                  placeholder={page.fields.graduationInstitutionPlaceholder}
                  data-i18n-placeholder="page.fields.graduationInstitutionPlaceholder"
                />
              </div>
              <div>
                <label for="degree">
                  <span data-i18n="page.fields.highestDegree">{page.fields.highestDegree}</span>{" "}
                  <span class="req">*</span>
                </label>
                <select id="degree" name="degree">
                  <option value="" disabled selected data-i18n="page.fields.highestDegreePlaceholder">
                    {page.fields.highestDegreePlaceholder}
                  </option>
                  {page.degreeOptions.map((option, optionIndex) => (
                    <option value={option} data-i18n={`page.degreeOptions.${optionIndex}`}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="wechat">
                  <span data-i18n="page.fields.wechatOrWhatsapp">{page.fields.wechatOrWhatsapp}</span>{" "}
                  <span class="req">*</span>
                </label>
                <input
                  id="wechat"
                  name="wechat"
                  type="text"
                  placeholder={page.fields.wechatOrWhatsappPlaceholder}
                  data-i18n-placeholder="page.fields.wechatOrWhatsappPlaceholder"
                />
              </div>
              <div>
                <label for="linkedin">
                  <span data-i18n="page.fields.linkedIn">{page.fields.linkedIn}</span>
                </label>
                <input
                  id="linkedin"
                  name="linkedin"
                  type="url"
                  placeholder={page.fields.linkedInPlaceholder}
                  data-i18n-placeholder="page.fields.linkedInPlaceholder"
                />
              </div>
            </div>

            <div class="form-row">
              <label for="email">
                <span data-i18n="page.fields.email">{page.fields.email}</span> <span class="req">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder={page.fields.emailPlaceholder}
                data-i18n-placeholder="page.fields.emailPlaceholder"
              />
            </div>
          </section>

          <section class="form-section" id="section-3">
            <div class="form-section-header">
              <div class="form-section-number">3</div>
              <div>
                <h2 class="form-section-title" data-i18n="page.sections.projectTitle">
                  {page.sections.projectTitle}
                </h2>
                <p class="form-section-subtitle" data-i18n="page.sections.projectSubtitle">
                  {page.sections.projectSubtitle}
                </p>
              </div>
            </div>

            <div class="form-row">
              <label for="elevatorPitch">
                <span data-i18n="page.fields.elevatorPitch">{page.fields.elevatorPitch}</span>{" "}
                <span class="req">*</span>{" "}
                <span class="hint" data-i18n="page.fields.elevatorPitchHint">
                  {page.fields.elevatorPitchHint}
                </span>
              </label>
              <div class="field-wrap">
                <input
                  id="elevatorPitch"
                  name="elevatorPitch"
                  type="text"
                  class="has-ai-input"
                  placeholder={page.fields.elevatorPitchPlaceholder}
                  data-i18n-placeholder="page.fields.elevatorPitchPlaceholder"
                />
              </div>
            </div>

            {aiTextareaFields.map((field) => (
              <div class="form-row">
                <label for={field.id}>
                  <span data-i18n={field.labelKey}>{field.label}</span> <span class="req">*</span>
                </label>
                <div class="field-wrap">
                  <textarea
                    id={field.id}
                    name={field.id}
                    rows="4"
                    class="has-ai"
                    placeholder={field.placeholder}
                    data-i18n-placeholder={field.placeholderKey}
                  ></textarea>
                </div>
              </div>
            ))}

            <div class="form-row">
              <label for="suppFile">
                <span data-i18n="page.fields.supplementaryMaterials">
                  {page.fields.supplementaryMaterials}
                </span>{" "}
                <span class="hint" data-i18n="page.fields.supplementaryMaterialsHint">
                  {page.fields.supplementaryMaterialsHint}
                </span>
              </label>
              <label class="file-upload-area" for="suppFile">
                <input id="suppFile" name="suppFile" type="file" multiple />
                <span class="file-upload-icon">↑</span>
                <span class="file-upload-label" data-i18n="page.fields.supplementaryMaterialsUploadLabel">
                  {page.fields.supplementaryMaterialsUploadLabel}
                </span>
                <span class="file-upload-sub" data-i18n="page.fields.supplementaryMaterialsUploadSubtext">
                  {page.fields.supplementaryMaterialsUploadSubtext}
                </span>
              </label>
            </div>

            <div class="form-row">
              <span class="label-like">
                <span data-i18n="page.fields.expectedBenefits">{page.fields.expectedBenefits}</span>{" "}
                <span class="req">*</span>
              </span>
              <div class="benefit-grid">
                {page.benefits.map((benefit, benefitIndex) => (
                  <label class="benefit-item">
                    <input type="checkbox" name="benefits" value={benefit.value} />
                    <span class:list={["benefit-icon", `benefit-icon--${benefit.tone}`]}>
                      <Icon name={benefit.icon} size={16} />
                    </span>
                    <span data-i18n={`page.benefits.${benefitIndex}.label`}>{benefit.label}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <label for="hearAbout">
                <span data-i18n="page.fields.hearAbout">{page.fields.hearAbout}</span>{" "}
                <span class="req">*</span>
              </label>
              <select id="hearAbout" name="hearAbout">
                <option value="" disabled selected data-i18n="page.fields.hearAboutPlaceholder">
                  {page.fields.hearAboutPlaceholder}
                </option>
                {page.hearAboutOptions.map((option, optionIndex) => (
                  <option value={option} data-i18n={`page.hearAboutOptions.${optionIndex}`}>
                    {option}
                  </option>
                ))}
              </select>
            </div>
          </section>

          <section class="form-section" id="section-4">
            <div class="form-section-header">
              <div class="form-section-number">4</div>
              <div>
                <h2 class="form-section-title" data-i18n="page.sections.beijingTitle">
                  {page.sections.beijingTitle}
                </h2>
                <p class="form-section-subtitle" data-i18n="page.sections.beijingSubtitle">
                  {page.sections.beijingSubtitle}
                </p>
              </div>
            </div>

            <div class="form-note" data-i18n="page.notes.beijing">{page.notes.beijing}</div>

            <div class="form-row">
              <label for="beijingPlan">
                <span data-i18n="page.fields.beijingPlan">{page.fields.beijingPlan}</span>{" "}
                <span class="req">*</span>
              </label>
              <div class="field-wrap">
                <textarea
                  id="beijingPlan"
                  name="beijingPlan"
                  rows="7"
                  class="has-ai"
                  placeholder={page.fields.beijingPlanPlaceholder}
                  data-i18n-placeholder="page.fields.beijingPlanPlaceholder"
                ></textarea>
              </div>
            </div>

            <div class="form-row">
              <label for="incorporationTimeline">
                <span data-i18n="page.fields.incorporationTimeline">
                  {page.fields.incorporationTimeline}
                </span>{" "}
                <span class="hint" data-i18n="page.fields.incorporationTimelineHint">
                  {page.fields.incorporationTimelineHint}
                </span>
              </label>
              <select id="incorporationTimeline" name="incorporationTimeline">
                <option value="" disabled selected data-i18n="page.fields.incorporationTimelinePlaceholder">
                  {page.fields.incorporationTimelinePlaceholder}
                </option>
                {page.incorporationTimelineOptions.map((option, optionIndex) => (
                  <option value={option} data-i18n={`page.incorporationTimelineOptions.${optionIndex}`}>
                    {option}
                  </option>
                ))}
              </select>
            </div>
          </section>

          <section class="submit-section">
            <p class="submit-note" data-i18n-html="page.submitNoteHtml" set:html={page.submitNoteHtml}></p>
            <div class="submit-side">
              <p class="form-status" data-prereg-status role="status" aria-live="polite"></p>
              <div class="submit-actions">
                <button type="button" class="site-btn site-btn--secondary" data-save-draft data-i18n="page.saveDraftLabel">{page.saveDraftLabel}</button>
                <button type="submit" class="site-btn site-btn--primary site-btn--submit" data-prereg-submit data-i18n="page.submitLabel">{page.submitLabel}</button>
              </div>
              <p class="save-draft-hint" data-save-draft-hint data-i18n="page.saveDraft.hint">{page.saveDraft.hint}</p>
              <p class="save-draft-confirmation" data-save-draft-confirmation hidden></p>
            </div>
          </section>
        </form>
        <div class="prereg-success-panel" data-prereg-success hidden>
          <h2 data-i18n="page.submission.successMessage">{page.submission.successMessage}</h2>
        </div>
      </div>
    </section>
  </main>

  <InteriorFooter footer={locale.footer} ui={locale.ui} siteSettings={siteSettings} currentLanguage={currentLanguage} />
</div>

<script>
  const competitionSelect = document.querySelector("[data-competition-select]");
  const competitionHiddenInput = document.querySelector("[data-competition-hidden]");
  const competitionSelectRow = document.querySelector("[data-competition-select-row]");
  const competitionContext = document.querySelector("[data-selected-competition-context]");
  const competitionName = document.querySelector("[data-selected-competition-name]");
  const pageEyebrow = document.querySelector("[data-prereg-page-eyebrow]");
  const pageTitle = document.querySelector("[data-prereg-page-title]");
  const pageSubtitle = document.querySelector("[data-prereg-page-subtitle]");
  const defaultApplicationModeElement = document.querySelector("[data-prereg-default-application-mode]");
  const bannerBadge = document.querySelector("[data-prereg-banner-badge]");
  const bannerTitle = document.querySelector("[data-prereg-banner-title]");
  const applicationModeCopyElements = Array.from(document.querySelectorAll("[data-prereg-mode-copy]"));

  function getDefaultApplicationMode() {
    return defaultApplicationModeElement?.textContent?.trim() || "registration";
  }

  function getApplicationModeCopy(mode) {
    const fallbackMode = getDefaultApplicationMode();
    const copyElement =
      applicationModeCopyElements.find((element) => element.getAttribute("data-prereg-mode-copy") === mode) ||
      applicationModeCopyElements.find((element) => element.getAttribute("data-prereg-mode-copy") === fallbackMode);

    return {
      statusLabel: copyElement?.querySelector("[data-prereg-mode-status-label]")?.textContent?.trim() || "",
      titleSuffix: copyElement?.querySelector("[data-prereg-mode-title-suffix]")?.textContent?.trim() || "",
      selectedSubtitleTemplate:
        copyElement?.querySelector("[data-prereg-mode-selected-subtitle-template]")?.textContent?.trim() || "",
      bannerBadge: copyElement?.querySelector("[data-prereg-mode-banner-badge]")?.textContent?.trim() || "",
      bannerTitle: copyElement?.querySelector("[data-prereg-mode-banner-title]")?.textContent?.trim() || "",
    };
  }

  function escapeHtml(value) {
    return value.replace(/[&<>"']/g, (character) => {
      const entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };

      return entities[character] || character;
    });
  }

  function syncCompetitionSelection() {
    if (!(competitionSelect instanceof HTMLSelectElement) || !(competitionHiddenInput instanceof HTMLInputElement)) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    const competitionSlug = params.get("competition");

    if (competitionSlug) {
      const matchingOption = Array.from(competitionSelect.options).find(
        (option) => option.value === competitionSlug,
      );

      if (matchingOption) {
        competitionSelect.value = competitionSlug;
      }
    }

    competitionHiddenInput.value = competitionSelect.value;
    competitionSelect.disabled = Boolean(competitionSlug && competitionSelect.value);

    if (competitionSelectRow instanceof HTMLElement) {
      competitionSelectRow.hidden = Boolean(competitionSlug && competitionSelect.value);
    }

    if (!(competitionContext instanceof HTMLElement) || !(competitionName instanceof HTMLElement)) {
      return;
    }

    const selectedOption = competitionSelect.selectedOptions[0];
    const hasSelection = Boolean(competitionSelect.value && selectedOption);
    const selectedLabel = selectedOption?.textContent?.trim() || "";
    const selectedApplicationMode =
      selectedOption instanceof HTMLOptionElement
        ? selectedOption.dataset.applicationMode || getDefaultApplicationMode()
        : getDefaultApplicationMode();
    const modeCopy = getApplicationModeCopy(selectedApplicationMode);

    competitionContext.hidden = !hasSelection;
    competitionName.textContent = hasSelection ? selectedLabel : "";

    if (pageEyebrow instanceof HTMLElement && modeCopy.statusLabel) {
      pageEyebrow.textContent = modeCopy.statusLabel;
    }

    if (bannerBadge instanceof HTMLElement && modeCopy.bannerBadge) {
      bannerBadge.textContent = modeCopy.bannerBadge;
    }

    if (bannerTitle instanceof HTMLElement && modeCopy.bannerTitle) {
      bannerTitle.textContent = modeCopy.bannerTitle;
    }

    if (
      hasSelection &&
      competitionSlug &&
      pageEyebrow instanceof HTMLElement &&
      pageTitle instanceof HTMLElement &&
      pageSubtitle instanceof HTMLElement &&
      modeCopy.titleSuffix &&
      modeCopy.selectedSubtitleTemplate
    ) {
      pageTitle.innerHTML = `${escapeHtml(selectedLabel)}<br /><em>${escapeHtml(modeCopy.titleSuffix)}</em>`;
      pageSubtitle.textContent = modeCopy.selectedSubtitleTemplate.replace("{competition}", selectedLabel);
    }
  }

  if (competitionSelect instanceof HTMLSelectElement) {
    syncCompetitionSelection();
    competitionSelect.addEventListener("change", syncCompetitionSelection);
    window.addEventListener("pageshow", syncCompetitionSelection);
    const competitionObserver = new MutationObserver(syncCompetitionSelection);
    competitionObserver.observe(competitionSelect, {
      childList: true,
      subtree: true,
      characterData: true,
    });
  }

  // ---- Pre-registration submission wiring ----
  import { submitPreRegistration } from "../../lib/pre-registration/submit.mjs";
  import { validateFileSizes, fileToBase64 } from "../../lib/pre-registration/files.mjs";

  const preregForm = document.querySelector("[data-prereg-form]");
  if (preregForm instanceof HTMLFormElement) {
    const endpoint = preregForm.dataset.endpoint || "";
    const statusEl = document.querySelector("[data-prereg-status]");
    const submitBtn = preregForm.querySelector("[data-prereg-submit]");
    const successPanel = document.querySelector("[data-prereg-success]");
    const saveDraftBtn = document.querySelector("[data-save-draft]");
    const draftConfirmEl = document.querySelector("[data-save-draft-confirmation]");
    const DRAFT_KEY = "preRegistrationDraft";

    const island = document.getElementById("localized-content");
    const content = island ? JSON.parse(island.textContent || "{}") : {};
    const lang = () => {
      const code = window.localStorage.getItem("preferredLanguage") || "EN";
      return content[code] ? code : (content.EN ? "EN" : Object.keys(content)[0]);
    };
    const copy = () => (content[lang()] && content[lang()].preRegistrationPage) || {};
    const submissionCopy = () => copy().submission || {};
    const draftCopy = () => copy().saveDraft || {};

    const setStatus = (type, message) => {
      if (!(statusEl instanceof HTMLElement)) return;
      statusEl.textContent = message || "";
      statusEl.className = `form-status${type ? ` form-status--${type}` : ""}`;
    };

    // ---- Draft persistence (localStorage; files are NOT persisted) ----
    const draftableFields = () =>
      Array.from(preregForm.elements).filter(
        (el) =>
          (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) &&
          el.name && el.type !== "file" && el.name !== "botcheck",
      );

    const saveDraft = () => {
      const data = {};
      draftableFields().forEach((el) => {
        if (el instanceof HTMLInputElement && (el.type === "checkbox" || el.type === "radio")) {
          if (el.checked) { (data[el.name] = data[el.name] || []).push(el.value); }
        } else {
          data[el.name] = el.value;
        }
      });
      try { window.localStorage.setItem(DRAFT_KEY, JSON.stringify(data)); } catch (_) {}
      if (draftConfirmEl instanceof HTMLElement) {
        draftConfirmEl.textContent = `${draftCopy().confirmation || "Draft saved"} ${new Date().toLocaleTimeString()}`;
        draftConfirmEl.hidden = false;
      }
    };

    const restoreDraft = () => {
      let data;
      try { data = JSON.parse(window.localStorage.getItem(DRAFT_KEY) || "null"); } catch (_) { data = null; }
      if (!data) return;
      draftableFields().forEach((el) => {
        const saved = data[el.name];
        if (saved === undefined) return;
        if (el instanceof HTMLInputElement && (el.type === "checkbox" || el.type === "radio")) {
          el.checked = Array.isArray(saved) && saved.includes(el.value);
        } else {
          el.value = saved;
        }
      });
      const select = preregForm.querySelector("[data-competition-select]");
      if (select instanceof HTMLSelectElement) select.dispatchEvent(new Event("change"));
    };

    if (saveDraftBtn instanceof HTMLElement) saveDraftBtn.addEventListener("click", saveDraft);
    restoreDraft();

    // ---- Required validation ----
    const REQUIRED = [
      "selectedCompetition", "projectName", "projectIntro", "compField", "companyHeadquarters",
      "compLocation", "compFullName", "applicantName", "gender", "dob", "nationality",
      "university", "degree", "wechat", "email", "elevatorPitch", "projectOverview",
      "productFeatures", "businessModel", "teamIntroduction", "investmentValue",
      "fundingAmountRequested", "hearAbout", "beijingPlan",
    ];
    const fieldValue = (name) => {
      const els = preregForm.elements[name];
      if (!els) return "";
      if (els instanceof RadioNodeList) return els.value;
      if (els instanceof HTMLInputElement && els.type === "radio") return els.checked ? els.value : "";
      return (els.value || "").trim();
    };
    const validate = () => {
      for (const name of REQUIRED) { if (!fieldValue(name)) return false; }
      const benefits = preregForm.querySelectorAll('input[name="benefits"]:checked');
      if (benefits.length === 0) return false;
      const deck = preregForm.querySelector("[data-deck-file-input]");
      const deckLink = fieldValue("deckLink");
      const hasDeck = deck instanceof HTMLInputElement && deck.files && deck.files.length > 0;
      if (!hasDeck && !deckLink) return false;
      return true;
    };

    // ---- Submit ----
    preregForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const sc = submissionCopy();
      if (preregForm.querySelector('[name="botcheck"]')?.checked) { /* bot */ return; }
      if (!validate()) { setStatus("error", sc.validationMessage || "Please complete required fields."); return; }

      const deckInput = preregForm.querySelector("[data-deck-file-input]");
      const suppInput = preregForm.querySelector('input[name="suppFile"]');
      const deckFiles = deckInput instanceof HTMLInputElement && deckInput.files ? Array.from(deckInput.files) : [];
      const suppFiles = suppInput instanceof HTMLInputElement && suppInput.files ? Array.from(suppInput.files) : [];
      const sizeCheck = validateFileSizes([...deckFiles, ...suppFiles].map((f) => ({ name: f.name, size: f.size })));
      if (!sizeCheck.ok) { setStatus("error", sizeCheck.error); return; }

      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      setStatus("pending", sc.uploadPendingMessage || "Uploading...");

      const fd = new FormData();
      const append = (k, v) => fd.append(k, v == null ? "" : String(v));
      const selectEl = preregForm.querySelector("[data-competition-select]");
      const selectedOption = selectEl instanceof HTMLSelectElement ? selectEl.selectedOptions[0] : null;
      append("submissionId", `prereg-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);
      append("language", lang());
      append("competitionSlug", fieldValue("selectedCompetition"));
      append("competitionName", selectedOption ? selectedOption.textContent.trim() : "");
      ["projectName","projectIntro","compField","companyHeadquarters","compLocation","compFullName",
       "officeAddress","applicantName","gender","dob","nationality","university","degree","wechat",
       "linkedin","email","elevatorPitch","projectOverview","productFeatures","businessModel",
       "teamIntroduction","investmentValue","fundingAmountRequested","hearAbout","beijingPlan",
       "incorporationTimeline","deckLink"].forEach((name) => append(name, fieldValue(name)));
      append("benefits", Array.from(preregForm.querySelectorAll('input[name="benefits"]:checked')).map((b) => b.value).join(", "));
      append("userAgent", navigator.userAgent);
      append("referrer", document.referrer);

      try {
        if (deckFiles[0]) {
          setStatus("pending", sc.submittingMessage || "Submitting...");
          append("deckFile_base64", await fileToBase64(deckFiles[0]));
          append("deckFile_name", deckFiles[0].name);
          append("deckFile_type", deckFiles[0].type);
        }
        append("suppFile_count", String(suppFiles.length));
        for (let i = 0; i < suppFiles.length; i++) {
          append(`suppFile_base64_${i}`, await fileToBase64(suppFiles[i]));
          append(`suppFile_name_${i}`, suppFiles[i].name);
          append(`suppFile_type_${i}`, suppFiles[i].type);
        }
      } catch (_) {
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        setStatus("error", sc.errorMessage || "We could not read your files. Please try again.");
        return;
      }

      setStatus("pending", sc.submittingMessage || "Submitting...");
      const result = await submitPreRegistration(endpoint, fd);
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;

      if (result.ok) {
        try { window.localStorage.removeItem(DRAFT_KEY); } catch (_) {}
        preregForm.hidden = true;
        if (successPanel instanceof HTMLElement) successPanel.hidden = false;
        setStatus("", "");
      } else {
        setStatus("error", sc.errorMessage || "We could not submit the form. Please try again.");
      }
    });
  }
</script>
