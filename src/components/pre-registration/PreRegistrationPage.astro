---
import InteriorFooter from "../site/InteriorFooter.astro";
import InteriorHeader from "../site/InteriorHeader.astro";

import type { SiteSettings } from "../../lib/homepage/types";
import type {
  InteriorFooterContent,
  InteriorNavItem,
  PreRegistrationPageContent,
} from "../../content/interior-pages";

interface Props {
  page: PreRegistrationPageContent;
  navItems: InteriorNavItem[];
  footer: InteriorFooterContent;
  siteSettings: SiteSettings;
}

const { page, navItems, footer, siteSettings } = Astro.props;

const aiTextareaFields = [
  {
    id: "projectOverview",
    label: "Project Overview",
    placeholder:
      "Provide a detailed overview of your project — the problem it addresses, your solution approach, and why now.",
  },
  {
    id: "productFeatures",
    label: "Product / Service Features",
    placeholder: "Describe the key features and differentiators of your product or service.",
  },
  {
    id: "businessModel",
    label: "Business Model",
    placeholder: "Explain how your startup generates revenue and your go-to-market strategy.",
  },
  {
    id: "teamIntro",
    label: "Team Introduction",
    placeholder:
      "Introduce your founding team — backgrounds, expertise, and why you're the right team to execute this vision.",
  },
  {
    id: "investmentValue",
    label: "Investment Value",
    placeholder:
      "Describe your investment opportunity — current traction, financials, use of funds, and growth potential.",
  },
];
---

<div class="interior-page">
  <InteriorHeader
    navItems={navItems}
    activeLabel="Competitions & Challenges"
    siteSettings={siteSettings}
  />

  <main>
    <section class="page-header">
      <div class="interior-wrap page-header-inner page-header-inner--split">
        <div>
          <div class="page-eyebrow">
            <span class="dot"></span>
            {page.eyebrow}
          </div>
          <h1 class="page-title" set:html={page.titleHtml}></h1>
        </div>
        <p class="page-subtitle">{page.subtitle}</p>
      </div>
    </section>

    <section class="interior-wrap pre-registration-shell">
      <div class="prereg-banner">
        <div class="prereg-banner-copy">
          <div class="prereg-banner-badge">{page.banner.badge}</div>
          <h2>{page.banner.title}</h2>
          <p set:html={page.banner.descriptionHtml}></p>
        </div>

        <aside class="prereg-support-card">
          <div class="prereg-support-label">{page.banner.supportLabel}</div>
          <div class="prereg-support-name">{page.banner.supportName}</div>
          <div class="prereg-support-items">
            {page.banner.supportItems.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </aside>
      </div>

      <div class="tutorial-area">
        <div class="tutorial-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>

        <div class="tutorial-body">
          <h2>{page.guide.title}</h2>
          <p>{page.guide.description}</p>
        </div>

        <div class="tutorial-actions">
          {page.guide.actions.map((action) => (
            <a
              href={action.href}
              class:list={[
                "site-btn",
                action.theme === "dark" ? "site-btn--dark" : "site-btn--secondary",
              ]}
            >
              <span class="resource-icon" aria-hidden="true">
                {action.icon === "download" ? "↓" : "▶"}
              </span>
              {action.label}
            </a>
          ))}
        </div>
      </div>

      <div class="form-progress" aria-label="Form progress">
        {page.progressSteps.map((step, index) => (
          <a
            href={`#${step.target}`}
            class:list={["progress-step", index === 0 && "is-active"]}
          >
            <span class="progress-step-number">{step.number}</span>
            {step.label}
          </a>
        ))}
      </div>

      <div class="form-wrap">
        <form class="pre-reg-form">
          <section class="form-section" id="section-1">
            <div class="form-section-header">
              <div class="form-section-number">1</div>
              <div>
                <h2 class="form-section-title">Competition Information</h2>
                <p class="form-section-subtitle">
                  Basic details about your project and company registration.
                </p>
              </div>
            </div>

            <div class="form-row">
              <label for="projectName">Project Name <span class="req">*</span></label>
              <input id="projectName" name="projectName" type="text" placeholder="Your project or startup name" />
            </div>

            <div class="form-row">
              <label for="projectIntro">
                Project Introduction <span class="req">*</span> <span class="hint">30-50 words</span>
              </label>
              <div class="field-wrap">
                <textarea
                  id="projectIntro"
                  name="projectIntro"
                  rows="4"
                  class="has-ai"
                  placeholder="Describe your project in 30-50 words. What problem does it solve? Who does it serve?"
                ></textarea>
                <button type="button" class="ai-btn">Write with AI</button>
              </div>
              <div class="word-count">Target: 30-50 words</div>
            </div>

            <div class="form-row">
              <label for="compField">Competition Field <span class="req">*</span></label>
              <select id="compField" name="compField">
                <option value="">Select your primary tech vertical</option>
                {page.competitionFieldOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>

            <div class="form-row">
              <span class="label-like">Where is your company headquartered? <span class="req">*</span></span>
              <div class="radio-group">
                {page.companyHeadquartersOptions.map((option, index) => (
                  <label class="radio-pill">
                    <input
                      type="radio"
                      name="companyHeadquarters"
                      value={option}
                      checked={index === 1}
                    />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <label for="compLocation">Company Location <span class="req">*</span></label>
              <input
                id="compLocation"
                name="compLocation"
                type="text"
                placeholder="City, Country (e.g. São Paulo, Brazil)"
              />
            </div>

            <div class="form-row">
              <label for="compFullName">Full Name of the Company</label>
              <input
                id="compFullName"
                name="compFullName"
                type="text"
                placeholder="Registered company name (if applicable)"
              />
            </div>

            <div class="form-row">
              <label for="officeAddress">Office Address</label>
              <input
                id="officeAddress"
                name="officeAddress"
                type="text"
                placeholder="Full registered office address"
              />
            </div>
          </section>

          <section class="form-section" id="section-2">
            <div class="form-section-header">
              <div class="form-section-number">2</div>
              <div>
                <h2 class="form-section-title">Main Participant Applicant</h2>
                <p class="form-section-subtitle">Personal details of the lead applicant.</p>
              </div>
            </div>

            <div class="form-note">
              <strong>Instructions:</strong> The main applicant should be the largest natural shareholder and be available for a semi-finals roadshow if selected.
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="applicantName">Full Name <span class="req">*</span></label>
                <input id="applicantName" name="applicantName" type="text" placeholder="First and Last name" />
              </div>
              <div>
                <span class="label-like">Gender <span class="req">*</span></span>
                <div class="radio-group">
                  {["Male", "Female", "Other"].map((option) => (
                    <label class="radio-pill">
                      <input type="radio" name="gender" value={option} />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="dob">Date of Birth <span class="req">*</span></label>
                <input id="dob" name="dob" type="date" />
              </div>
              <div>
                <label for="nationality">Nationality <span class="req">*</span></label>
                <input
                  id="nationality"
                  name="nationality"
                  type="text"
                  placeholder="e.g. Brazilian, Mexican, Colombian"
                />
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="university">Latest Graduation Institution <span class="req">*</span></label>
                <input id="university" name="university" type="text" placeholder="University or institution name" />
              </div>
              <div>
                <label for="degree">Highest Degree <span class="req">*</span></label>
                <select id="degree" name="degree">
                  <option value="">Select degree</option>
                  {page.degreeOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-row form-row--split">
              <div>
                <label for="wechat">WeChat or WhatsApp <span class="req">*</span></label>
                <input id="wechat" name="wechat" type="text" placeholder="WeChat ID or WhatsApp number" />
              </div>
              <div>
                <label for="linkedin">LinkedIn Profile</label>
                <input id="linkedin" name="linkedin" type="url" placeholder="https://linkedin.com/in/yourprofile" />
              </div>
            </div>

            <div class="form-row">
              <label for="email">Email Address <span class="req">*</span></label>
              <input id="email" name="email" type="email" placeholder="your@email.com" />
            </div>
          </section>

          <section class="form-section" id="section-3">
            <div class="form-section-header">
              <div class="form-section-number">3</div>
              <div>
                <h2 class="form-section-title">Project Information</h2>
                <p class="form-section-subtitle">
                  Tell us about your startup. Use the helper prompts if you want a faster first draft.
                </p>
              </div>
            </div>

            <div class="form-row">
              <label for="elevatorPitch">
                Elevator Pitch <span class="req">*</span> <span class="hint">One compelling sentence</span>
              </label>
              <div class="field-wrap">
                <input
                  id="elevatorPitch"
                  name="elevatorPitch"
                  type="text"
                  class="has-ai-input"
                  placeholder="Add a compelling one-sentence pitch for your startup"
                />
                <button type="button" class="ai-btn">Write with AI</button>
              </div>
            </div>

            {aiTextareaFields.map((field) => (
              <div class="form-row">
                <label for={field.id}>{field.label} <span class="req">*</span></label>
                <div class="field-wrap">
                  <textarea id={field.id} name={field.id} rows="4" class="has-ai" placeholder={field.placeholder}></textarea>
                  <button type="button" class="ai-btn">Write with AI</button>
                </div>
              </div>
            ))}

            <div class="form-row">
              <label for="deckFile">
                Pitching Deck <span class="req">*</span> <span class="hint">PDF or PPT, max 20MB</span>
              </label>
              <label class="file-upload-area" for="deckFile">
                <input id="deckFile" name="deckFile" type="file" accept=".pdf,.ppt,.pptx" />
                <span class="file-upload-icon">↑</span>
                <span class="file-upload-label">Click to upload your Pitch Deck</span>
                <span class="file-upload-sub">PDF, PPT or PPTX — Maximum 20MB</span>
              </label>
            </div>

            <div class="form-row">
              <label for="suppFile">
                Supplementary Materials <span class="hint">Optional — videos, demos, reports</span>
              </label>
              <label class="file-upload-area" for="suppFile">
                <input id="suppFile" name="suppFile" type="file" multiple />
                <span class="file-upload-icon">↑</span>
                <span class="file-upload-label">Upload supplementary materials</span>
                <span class="file-upload-sub">Any format — videos, demos, reports, patents</span>
              </label>
            </div>

            <div class="form-row">
              <span class="label-like">What do you expect to receive? <span class="req">*</span></span>
              <div class="benefit-grid">
                {page.benefits.map((benefit) => (
                  <label class="benefit-item">
                    <input type="checkbox" name="benefits" value={benefit.value} />
                    <span class:list={["benefit-icon", `benefit-icon--${benefit.tone}`]}>
                      {benefit.short}
                    </span>
                    <span>{benefit.label}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-row">
              <label for="hearAbout">Where did you hear about us? <span class="req">*</span></label>
              <select id="hearAbout" name="hearAbout">
                <option value="">Select a source</option>
                {page.hearAboutOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>
          </section>

          <section class="form-section" id="section-4">
            <div class="form-section-header">
              <div class="form-section-number">4</div>
              <div>
                <h2 class="form-section-title">Plan for Incorporation in Beijing</h2>
                <p class="form-section-subtitle">Required for prize eligibility.</p>
              </div>
            </div>

            <div class="form-note">
              <strong>Important:</strong> Incorporation in Beijing is the goal of the organizers and is mandatory to receive your awarded prize.
            </div>

            <div class="form-row">
              <label for="beijingPlan">
                Beijing Incorporation &amp; China Opportunity Plan <span class="req">*</span>
              </label>
              <div class="field-wrap">
                <textarea
                  id="beijingPlan"
                  name="beijingPlan"
                  rows="7"
                  class="has-ai"
                  placeholder="Describe your plan for incorporating in Beijing. How does your startup leverage China's market, technology ecosystem, policy environment, or talent pool?"
                ></textarea>
                <button type="button" class="ai-btn">Write with AI</button>
              </div>
            </div>

            <div class="form-row">
              <label for="incorporationTimeline">
                Intended Incorporation Timeline in Beijing <span class="hint">Full 1-on-1 incorporation support will be provided</span>
              </label>
              <select id="incorporationTimeline" name="incorporationTimeline">
                <option value="">When do you plan to incorporate?</option>
                {page.incorporationTimelineOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </div>
          </section>

          <section class="submit-section">
            <p class="submit-note" set:html={page.submitNoteHtml}></p>
            <div class="submit-actions">
              <button type="button" class="site-btn site-btn--secondary">Save Draft</button>
              <button type="submit" class="site-btn site-btn--primary">Submit Pre-Registration</button>
            </div>
          </section>
        </form>
      </div>
    </section>
  </main>

  <InteriorFooter footer={footer} siteSettings={siteSettings} />
</div>
