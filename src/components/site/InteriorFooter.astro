---
import LanguageSwitcher from "./LanguageSwitcher.astro";

import type { SiteSettings } from "../../lib/homepage/types";
import type { InteriorFooterContent, InteriorPageUi } from "../../lib/interior-pages/types";

interface Props {
  footer: InteriorFooterContent;
  ui: InteriorPageUi;
  siteSettings: SiteSettings;
  currentLanguage?: string;
}

const {
  footer,
  ui,
  siteSettings,
  currentLanguage = siteSettings.defaultLanguage,
} = Astro.props;
---

<footer class="site-footer" id="site-footer">
  <div class="site-footer-stripe"></div>

  <section class="site-footer-hero">
    <div class="interior-wrap site-footer-hero-inner">
      <div>
        <div class="site-footer-eyebrow" data-i18n="footer.eyebrow">{footer.eyebrow}</div>
        <h2 class="site-footer-title" data-i18n-html="footer.titleHtml" set:html={footer.titleHtml}></h2>
      </div>

      <a href={footer.buttonHref} class="site-btn site-footer-hero-btn" data-i18n="footer.buttonLabel">
        {footer.buttonLabel}
      </a>
    </div>
  </section>

  <div class="site-footer-divider"></div>

  <section class="site-footer-body">
    <div class="interior-wrap site-footer-grid">
      <div class="site-footer-columns">
        {footer.columns.map((column, columnIndex) => (
          <div class="site-footer-column">
            <div class="site-footer-column-title" data-i18n={`footer.columns.${columnIndex}.title`}>
              {column.title}
            </div>
            <div class="site-footer-column-links">
              {column.links.map((link, linkIndex) => (
                <a href={link.href} data-i18n={`footer.columns.${columnIndex}.links.${linkIndex}.label`}>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="site-footer-newsletter">
        <div class="site-footer-column-title" data-i18n="footer.newsletterTitle">
          {footer.newsletterTitle}
        </div>
        <div class="site-footer-newsletter-row">
          <input
            type="email"
            placeholder={ui.newsletterPlaceholder}
            aria-label={ui.newsletterEmail}
            data-i18n-placeholder="ui.newsletterPlaceholder"
            data-i18n-aria-label="ui.newsletterEmail"
          />
          <a
            href={siteSettings.newsletterUrl}
            target="_blank"
            rel="noreferrer"
            class="site-footer-subscribe"
            data-i18n="footer.newsletterButtonLabel"
          >
            {footer.newsletterButtonLabel}
          </a>
        </div>

        <div class="site-footer-socials">
          <div class="site-wechat">
            <button
              type="button"
              class="site-social-btn"
              aria-label={footer.scanWechat}
              data-i18n-aria-label="footer.scanWechat"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8.5 2C4.36 2 1 5.03 1 8.78c0 1.99.98 3.77 2.53 4.97L2.5 16l2.7-1.35C6.1 14.87 7.27 15 8.5 15c.28 0 .56-.01.83-.04A5.54 5.54 0 0 1 9 13.22C9 10.33 11.91 8 15.5 8c.28 0 .56.01.83.03C15.62 4.6 12.4 2 8.5 2zm-2 4.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm5 3.5c-3.04 0-5.5 2.01-5.5 4.5S12.46 19 15.5 19c.7 0 1.37-.12 1.98-.33L20 20l-1.12-2.34C19.56 16.73 21 15.19 21 13.5 21 11.01 18.54 9 15.5 9zm-1.5 2.75a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zm3 0a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"></path>
              </svg>
            </button>
            <div class="site-wechat-popup">
              <div class="site-wechat-title" data-i18n="footer.scanWechat">{footer.scanWechat}</div>
              <div class="site-wechat-qr">
                <svg viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <rect width="96" height="96" fill="white"></rect>
                  <rect x="8" y="8" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="12" y="12" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="16" y="16" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="56" y="8" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="60" y="12" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="64" y="16" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="8" y="56" width="32" height="32" rx="2" fill="#111"></rect>
                  <rect x="12" y="60" width="24" height="24" rx="1" fill="white"></rect>
                  <rect x="16" y="64" width="16" height="16" rx="1" fill="#111"></rect>
                  <rect x="48" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="60" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="48" width="8" height="8" fill="#111"></rect>
                  <rect x="48" y="60" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="60" width="8" height="8" fill="#111"></rect>
                  <rect x="48" y="72" width="8" height="8" fill="#111"></rect>
                  <rect x="60" y="72" width="8" height="8" fill="#111"></rect>
                  <rect x="72" y="72" width="8" height="8" fill="#111"></rect>
                </svg>
              </div>
            </div>
          </div>
          <a
            href={siteSettings.socialLinks.instagram}
            target="_blank"
            rel="noreferrer"
            class="site-social-btn"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href={siteSettings.socialLinks.linkedin}
            target="_blank"
            rel="noreferrer"
            class="site-social-btn"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href={siteSettings.socialLinks.whatsapp}
            target="_blank"
            rel="noreferrer"
            class="site-social-btn"
            aria-label="WhatsApp"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="site-footer-lang">
        <LanguageSwitcher
          languages={siteSettings.languages}
          currentLanguage={currentLanguage}
          label={ui.chooseLanguage}
          labelTranslationKey="ui.chooseLanguage"
          className="site-lang--footer"
        />
      </div>
    </div>
  </section>

  <div class="site-footer-bottom-stripe"></div>
</footer>
