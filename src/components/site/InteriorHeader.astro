---
import BrandLogo from "./BrandLogo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

import {
  getDesktopMenuSectionHref,
  getDesktopMenuLinkHref,
  getDesktopMenuCardHref,
} from "../../lib/homepage/links";
import type { SiteSettings } from "../../lib/homepage/types";
import type { DesktopMenuSection } from "../../lib/homepage/types";
import type { InteriorNavItem } from "../../lib/interior-pages/types";

interface Props {
  navItems: InteriorNavItem[];
  activeHref: string;
  siteSettings: SiteSettings;
  currentLanguage: string;
  languageLabel?: string;
  homeLabel?: string;
  menuLabel?: string;
  desktopMenuSections?: DesktopMenuSection[];
  navExploreLabel?: string;
}

const {
  navItems,
  activeHref,
  siteSettings,
  currentLanguage,
  languageLabel = "Select language",
  homeLabel = siteSettings.siteName,
  menuLabel = "Menu",
  desktopMenuSections = [],
  navExploreLabel = "Explore",
} = Astro.props;
---

<header class="site-header">
  <div class="interior-wrap site-header-inner">
    <a
      href="/"
      class="site-brand"
      aria-label={homeLabel}
      data-i18n-aria-label="ui.homeLabel"
    >
      <BrandLogo alt={siteSettings.siteName} className="site-brand-image site-brand-image--dark" />
    </a>

    <nav class="site-nav" aria-label="Interior navigation">
      <ul class="site-nav-list">
        {navItems.map((item, index) => {
          const isActive = item.href === activeHref;
          const section = desktopMenuSections[index];
          const primaryCardHref = section?.card.href ?? getDesktopMenuCardHref(index);
          const secondaryCardHref = section?.card2?.href ?? getDesktopMenuCardHref(index);

          return (
            <li class="site-nav-item">
              <a
                href={item.href}
                class:list={["site-nav-link", isActive && "is-active"]}
                aria-current={isActive ? "page" : undefined}
                data-i18n={`navItems.${index}.label`}
              >
                {item.label}
              </a>
              {section && (
                <div class="site-mega">
                  {section.layout === "events" ? (
                    <div class="site-mega-grid site-mega-grid--events">
                      {section.events?.map((event, eventIndex) => (
                        <div class="site-mega-event">
                          <div class="site-mega-event-tag" data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.tag`}>
                            {event.tag}
                          </div>
                          <div class="site-mega-event-title" data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.title`}>
                            {event.title}
                          </div>
                          <p class="site-mega-event-body" data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.body`}>
                            {event.body}
                          </p>
                          <a href={getDesktopMenuLinkHref(index, eventIndex)} class="site-mega-event-link">
                            <span data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.linkText`}>
                              {event.linkText}
                            </span>
                          </a>
                        </div>
                      ))}
                    </div>
                  ) : section.layout === "two-cards" ? (
                    <div class="site-mega-grid site-mega-grid--two-cards">
                      <div>
                        <div class="site-mega-label" data-i18n="navExploreLabel">{navExploreLabel}</div>
                        <div class="site-mega-links">
                          {section.links.map((link, linkIndex) => (
                            <a href={getDesktopMenuLinkHref(index, linkIndex)} class="site-mega-link">
                              <span
                                class="site-mega-link-title"
                                data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.title`}
                              >
                                {link.title}
                              </span>
                              <span
                                class="site-mega-link-subtitle"
                                data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.subtitle`}
                              >
                                {link.subtitle}
                              </span>
                            </a>
                          ))}
                        </div>
                        <div class="site-mega-note">
                          <span data-i18n={`desktopMenuSections.${index}.note`}>{section.note}</span>
                          <a href="#contact" data-i18n={`desktopMenuSections.${index}.noteLink`}>
                            {section.noteLink}
                          </a>
                        </div>
                      </div>
                      <div class="site-mega-card">
                        <h3 data-i18n={`desktopMenuSections.${index}.card.title`}>
                          {section.card.title}
                        </h3>
                        <p data-i18n={`desktopMenuSections.${index}.card.body`}>
                          {section.card.body}
                        </p>
                        <a
                          href={primaryCardHref}
                          class="site-btn site-btn--primary site-btn--compact"
                          data-i18n={`desktopMenuSections.${index}.card.cta`}
                        >
                          {section.card.cta}
                        </a>
                      </div>
                      <div class="site-mega-card">
                        <h3 data-i18n={`desktopMenuSections.${index}.card2.title`}>
                          {section.card2?.title}
                        </h3>
                        <p data-i18n={`desktopMenuSections.${index}.card2.body`}>
                          {section.card2?.body}
                        </p>
                        <a
                          href={secondaryCardHref}
                          class="site-btn site-btn--primary site-btn--compact"
                          data-i18n={`desktopMenuSections.${index}.card2.cta`}
                        >
                          {section.card2?.cta}
                        </a>
                      </div>
                    </div>
                  ) : (
                    <div class="site-mega-grid">
                      <div>
                        <div class="site-mega-label" data-i18n="navExploreLabel">{navExploreLabel}</div>
                        <div class="site-mega-links">
                          {section.links.map((link, linkIndex) => (
                            <a href={getDesktopMenuLinkHref(index, linkIndex)} class="site-mega-link">
                              <span
                                class="site-mega-link-title"
                                data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.title`}
                              >
                                {link.title}
                              </span>
                              <span
                                class="site-mega-link-subtitle"
                                data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.subtitle`}
                              >
                                {link.subtitle}
                              </span>
                            </a>
                          ))}
                        </div>
                        <div class="site-mega-note">
                          <span data-i18n={`desktopMenuSections.${index}.note`}>{section.note}</span>
                          <a href="#contact" data-i18n={`desktopMenuSections.${index}.noteLink`}>
                            {section.noteLink}
                          </a>
                        </div>
                      </div>
                      <div class="site-mega-copy">
                        <p data-i18n={`desktopMenuSections.${index}.description`}>
                          {section.description}
                        </p>
                      </div>
                      <div class="site-mega-card">
                        <h3 data-i18n={`desktopMenuSections.${index}.card.title`}>
                          {section.card.title}
                        </h3>
                        <p data-i18n={`desktopMenuSections.${index}.card.body`}>
                          {section.card.body}
                        </p>
                        <a
                          href={getDesktopMenuCardHref(index)}
                          class="site-btn site-btn--primary site-btn--compact"
                          data-i18n={`desktopMenuSections.${index}.card.cta`}
                        >
                          {section.card.cta}
                        </a>
                      </div>
                    </div>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <LanguageSwitcher
      languages={siteSettings.languages}
      currentLanguage={currentLanguage}
      label={languageLabel}
      labelTranslationKey="ui.chooseLanguage"
    />

    <button
      type="button"
      class="site-mobile-menu-btn"
      id="mobileMenuBtn"
      aria-label={menuLabel}
      aria-expanded="false"
      aria-controls="mobileMenu"
      data-i18n-aria-label="ui.menu"
    >
      <span></span>
    </button>
  </div>

  <nav
    class="site-mobile-menu"
    id="mobileMenu"
    aria-label={menuLabel}
    data-i18n-aria-label="ui.menu"
  >
    <div class="site-mobile-menu-list">
      {navItems.map((item, index) => {
        const section = desktopMenuSections[index];
        const isActive = item.href === activeHref;
        const primaryCardHref = section?.card.href ?? getDesktopMenuCardHref(index);
        const secondaryCardHref = section?.card2?.href ?? getDesktopMenuCardHref(index);

        return (
          <div class:list={["site-mobile-menu-item", "mob-menu-item", isActive && "is-open"]}>
            <button
              type="button"
              class="site-mobile-menu-link"
              data-mobile-accordion
              aria-expanded={isActive ? "true" : "false"}
            >
              <span data-i18n={`navItems.${index}.label`}>{item.label}</span>
              <span class="site-mobile-menu-arrow" aria-hidden="true">›</span>
            </button>

            <div class="site-mobile-menu-panel">
              <a href={item.href} class="site-mobile-menu-primary">
                <span data-i18n={`navItems.${index}.label`}>{item.label}</span>
              </a>

              {section?.layout === "events" && (
                <div class="site-mobile-menu-links">
                  {section.events?.map((event, eventIndex) => (
                    <a href={getDesktopMenuLinkHref(index, eventIndex)} class="site-mobile-menu-sub-link">
                      <span data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.title`}>
                        {event.title}
                      </span>
                      <small data-i18n={`desktopMenuSections.${index}.events.${eventIndex}.tag`}>
                        {event.tag}
                      </small>
                    </a>
                  ))}
                </div>
              )}

              {section && section.layout !== "events" && (
                <div class="site-mobile-menu-links">
                  {section.links.map((link, linkIndex) => (
                    <a href={getDesktopMenuLinkHref(index, linkIndex)} class="site-mobile-menu-sub-link">
                      <span data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.title`}>
                        {link.title}
                      </span>
                      <small data-i18n={`desktopMenuSections.${index}.links.${linkIndex}.subtitle`}>
                        {link.subtitle}
                      </small>
                    </a>
                  ))}
                </div>
              )}

              {section?.card && (
                <a href={primaryCardHref} class="site-mobile-menu-card">
                  <strong data-i18n={`desktopMenuSections.${index}.card.title`}>
                    {section.card.title}
                  </strong>
                  <span data-i18n={`desktopMenuSections.${index}.card.cta`}>
                    {section.card.cta}
                  </span>
                </a>
              )}

              {section?.card2 && (
                <a href={secondaryCardHref} class="site-mobile-menu-card site-mobile-menu-card--alt">
                  <strong data-i18n={`desktopMenuSections.${index}.card2.title`}>
                    {section.card2.title}
                  </strong>
                  <span data-i18n={`desktopMenuSections.${index}.card2.cta`}>
                    {section.card2.cta}
                  </span>
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </nav>
</header>
