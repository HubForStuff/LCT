---
export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  htmlLang?: string;
}

const {
  title,
  description = "Conectando ideias, impulsionando negocios",
  bodyClass = "",
  htmlLang = "en",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class={`antialiased ${bodyClass}`.trim()}>
    <slot />
  </body>
</html>
