---

<Layout
  title="LATAM China Tech"
  description="We accelerate Latin American and Chinese tech."
  bodyClass="homepage-body"
>
  <main class="homepage">
    <section class="desktop-home" aria-label="Desktop homepage">
      <header class="desk-nav">
        <div class="desk-wrap desk-nav-inner">
          <a
            href="#"
            class="desk-brand"
            aria-label="LATAM China Tech home"
            data-i18n-aria-label="ui.homeLabel"
          >
            <span class="desk-brand-row">
              <span class="desk-brand-accent">LATAM</span>
              <span>CHINA</span>
            </span>
            <span class="desk-brand-sub">TECH</span>
          </a>

          <nav aria-label="Desktop navigation">
            <ul class="desk-nav-list">
              {desktopMenuSections.map((section, sectionIndex) => (
                <li class="desk-nav-item">
                  <a href="#" class="desk-nav-link" data-i18n={`desktopMenuSections.${sectionIndex}.label`}>
                    {section.label}
                  </a>
                  <div class="desk-mega">
                    <div class="desk-mega-grid">
                      <div>
                        <div class="desk-mega-label" data-i18n="navExploreLabel">Explore</div>
                        <div class="desk-mega-links">
                          {section.links.map((link, linkIndex) => (
                            <a href="#" class="desk-mega-link">
                              <span
                                class="desk-mega-link-title"
                                data-i18n={`desktopMenuSections.${sectionIndex}.links.${linkIndex}.title`}
                              >
                                {link.title}
                              </span>
                              <span
                                class="desk-mega-link-subtitle"
                                data-i18n={`desktopMenuSections.${sectionIndex}.links.${linkIndex}.subtitle`}
                              >
                                {link.subtitle}
                              </span>
                            </a>
                          ))}
                        </div>
                        <div class="desk-mega-note">
                          <span data-i18n={`desktopMenuSections.${sectionIndex}.note`}>{section.note}</span>
                          <a
                            href="#desktop-footer"
                            data-i18n={`desktopMenuSections.${sectionIndex}.noteLink`}
                          >
                            {section.noteLink}
                          </a>
                        </div>
                      </div>
                      <div class="desk-mega-copy">
                        <p data-i18n={`desktopMenuSections.${sectionIndex}.description`}>
                          {section.description}
                        </p>
                      </div>
                      <div class="desk-mega-card">
                        <h3 data-i18n={`desktopMenuSections.${sectionIndex}.card.title`}>
                          {section.card.title}
                        </h3>
                        <p data-i18n={`desktopMenuSections.${sectionIndex}.card.body`}>
                          {section.card.body}
                        </p>
                        <a
                          href="#"
                          class="desk-btn desk-btn--red desk-btn--compact"
                          data-i18n={`desktopMenuSections.${sectionIndex}.card.cta`}
                        >
                          {section.card.cta}
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </nav>

          <div class="desk-lang">
            <button
              type="button"
              class="desk-lang-btn"
              data-lang-toggle
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="Choose language"
              data-i18n-aria-label="ui.chooseLanguage"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </button>
            <div class="desk-lang-menu" data-lang-menu>
              {languages.map((language, index) => (
                <button
                  type="button"
                  class={`desk-lang-option ${index === 0 ? "is-active" : ""}`}
                  data-lang-option={language.code}
                >
                  <span>{language.code}</span>
                  <small>{language.label}</small>
                </button>
              ))}
            </div>
          </div>
        </div>
      </header>

      <section class="desk-hero">
        <div class="desk-wrap">
          <div class="desk-hero-copy">
            <h1 data-i18n-html="hero.desktopTitleHtml" set:html={localizedContent.EN.hero.desktopTitleHtml}></h1>
            <p class="desk-hero-sub" data-i18n="hero.subtitle">
              We Accelerate Latin American and Chinese Tech
            </p>
            <div class="desk-button-row">
              <a href="#desktop-categories" class="desk-btn desk-btn--white" data-i18n="hero.ctas.0">
                Explore Programs
              </a>
              <a href="#desktop-footer" class="desk-btn desk-btn--red" data-i18n="hero.ctas.1">
                Partner With Us
              </a>
              <a href="#desktop-news" class="desk-btn desk-btn--blue" data-i18n="hero.ctas.2">
                Read Insights
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="desk-section desk-categories" id="desktop-categories">
        <div class="desk-catblocks">
          {categoryCards.map((card, index) => (
            <a
              href="#desktop-footer"
              class={`desk-catblock ${card.theme === "light" ? "desk-catblock--light" : ""}`}
            >
              <div class="desk-catblock-body">
                <div class="desk-catblock-eye" data-i18n={`categoryCards.${index}.eyebrow`}>{card.eyebrow}</div>
                <h2 class="desk-catblock-title" data-i18n={`categoryCards.${index}.title`}>{card.title}</h2>
                <p class="desk-catblock-desc" data-i18n={`categoryCards.${index}.description`}>
                  {card.description}
                </p>
                <div class="desk-catblock-cta" data-i18n={`categoryCards.${index}.cta`}>{card.cta}</div>
              </div>
              <div class={`desk-catblock-media desk-catblock-media--${index + 1}`}></div>
            </a>
          ))}
        </div>
      </section>

      <section class="desk-section desk-section--alt" id="desktop-competitions">
        <div class="desk-wrap">
          <div class="desk-section-top">
            <div>
              <div class="desk-section-eye" data-i18n="competitionsSection.eye">Compete & Build</div>
              <h2 class="desk-section-title" data-i18n="competitionsSection.desktopTitle">
                Competitions & Corporate Challenges
              </h2>
            </div>
            <a href="#" class="desk-section-link" data-i18n="competitionsSection.allLink">All Challenges</a>
          </div>
        </div>

        <div class="desk-comp-grid">
          {competitionCards.map((card, index) => (
            <a href="#desktop-footer" class={`desk-comp-square desk-comp-square--${card.theme}`}>
              <div class="desk-comp-content">
                <div class="desk-comp-label" data-i18n={`competitionCards.${index}.label`}>{card.label}</div>
                <div
                  class="desk-comp-title"
                  data-i18n-html={`competitionCards.${index}.titleHtml`}
                  set:html={card.titleHtml}
                ></div>
                <p class="desk-comp-desc" data-i18n={`competitionCards.${index}.description`}>
                  {card.description}
                </p>
                <div class="desk-comp-badge" data-i18n={`competitionCards.${index}.status`}>{card.status}</div>
                <div class="desk-comp-cta" data-i18n={`competitionCards.${index}.cta`}>{card.cta}</div>
              </div>
              <div class="desk-comp-watermark" data-i18n={`competitionCards.${index}.watermark`}>
                {card.watermark}
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="desk-section desk-news" id="desktop-news">
        <div class="desk-wrap">
          <div class="desk-section-top">
            <div>
              <div class="desk-section-eye" data-i18n="newsSection.eye">Latest</div>
              <h2 class="desk-section-title" data-i18n="newsSection.title">News & Insights</h2>
            </div>
            <a href="#" class="desk-section-link" data-i18n="newsSection.allLink">All Insights</a>
          </div>

          <div class="desk-news-grid">
            {newsItems.map((item, index) => (
