---
import DesktopHome from "../components/home/DesktopHome.astro";
import HomeClient from "../components/home/HomeClient.astro";
import MobileHome from "../components/home/MobileHome.astro";
import Layout from "../layouts/Layout.astro";
import { getHomepageData } from "../lib/homepage/reader";
import "../styles/homepage.css";

const { defaultLanguage, defaultLocale, localizedContent, siteSettings } = await getHomepageData();
---

<Layout
  title={defaultLocale.meta.title}
  description={defaultLocale.meta.description}
  htmlLang={defaultLocale.meta.htmlLang}
  bodyClass="homepage-body"
>
  <main class="homepage">
    <DesktopHome
      locale={defaultLocale}
      languages={siteSettings.languages}
      siteSettings={siteSettings}
    />
    <MobileHome
      locale={defaultLocale}
      languages={siteSettings.languages}
      siteSettings={siteSettings}
    />
  </main>
  <HomeClient defaultLanguage={defaultLanguage} localizedContent={localizedContent} />
</Layout>
