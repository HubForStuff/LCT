---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="LATAMChina Tech" description="Conectando América Latina e China através da tecnologia">
  <Navigation />
  
  <main>
    <Hero />

    {/* Stats Section */}
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-4xl sm:text-5xl font-bold text-primary-500 mb-2">500+</div>
            <div class="text-gray-600">Empresas Conectadas</div>
          </div>
          <div>
            <div class="text-4xl sm:text-5xl font-bold text-primary-500 mb-2">50+</div>
            <div class="text-gray-600">Programas Ativos</div>
          </div>
          <div>
            <div class="text-4xl sm:text-5xl font-bold text-primary-500 mb-2">R$10M+</div>
            <div class="text-gray-600">Investimentos</div>
          </div>
          <div>
            <div class="text-4xl sm:text-5xl font-bold text-primary-500 mb-2">20+</div>
            <div class="text-gray-600">Parceiros</div>
          </div>
        </div>
      </div>
    </section>

    {/* Programs Section */}
    <section id="programas" class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Nossos Programas</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Pontes entre a América Latina e a China - tecnologia, comércio e inovação
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {/* Program Cards */}
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
              <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Programas de Expansão</h3>
              <p class="text-gray-600 mb-4">Acelere o crescimento da sua empresa com mentoria especializada e acesso a investidores.</p>
              <a href="#" class="text-primary-500 font-medium hover:text-primary-600 flex items-center">
                Saiba mais 
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center">
              <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Parcerias de Inovação</h3>
              <p class="text-gray-600 mb-4">Conecte-se com empresas líderes e desenvolva projetos inovadores em conjunto.</p>
              <a href="#" class="text-primary-500 font-medium hover:text-primary-600 flex items-center">
                Saiba mais 
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center">
              <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Consultoria Especializada</h3>
              <p class="text-gray-600 mb-4">Receba orientação estratégica de especialistas em inovação e transformação digital.</p>
              <a href="#" class="text-primary-500 font-medium hover:text-primary-600 flex items-center">
                Saiba mais 
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Competitions Section */}
    <section id="competicoes" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Competições & Desafios</h2>
            <p class="text-xl text-gray-600">Participe e leve sua ideia para o próximo nível</p>
          </div>
          <a href="#" class="mt-4 md:mt-0 inline-flex items-center text-primary-500 font-medium hover:text-primary-600">
            Ver todas as competições
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {/* Competition Cards */}
          <div class="border border-gray-200 rounded-xl p-6 hover:border-primary-300 hover:shadow-lg transition-all cursor-pointer">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-green-100 text-green-700 text-sm font-medium rounded-full">Aberto</span>
              <span class="text-gray-400 text-sm">Prazo: 30 dias</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Desafio de Sustentabilidade</h3>
            <p class="text-gray-600 mb-4">Soluções inovadoras para redução de carbono e economia circular.</p>
            <div class="flex items-center text-accent-500 font-semibold">
              <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-.464 5.535a1 1 0 10-1.415-1.414 3 3 0 01-4.242 0 1 1 0 00-1.415 1.414 5 5 0 007.072 0z"/>
              </svg>
              Prêmio: R$ 50.000
            </div>
          </div>

          <div class="border border-gray-200 rounded-xl p-6 hover:border-primary-300 hover:shadow-lg transition-all cursor-pointer">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">Em Breve</span>
              <span class="text-gray-400 text-sm">Abre em 15 dias</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Hackathon de IA</h3>
            <p class="text-gray-600 mb-4">Desenvolva soluções de inteligência artificial para problemas reais.</p>
            <div class="flex items-center text-accent-500 font-semibold">
              <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-.464 5.535a1 1 0 10-1.415-1.414 3 3 0 01-4.242 0 1 1 0 00-1.415 1.414 5 5 0 007.072 0z"/>
              </svg>
              Prêmio: R$ 100.000
            </div>
          </div>

          <div class="border border-gray-200 rounded-xl p-6 hover:border-primary-300 hover:shadow-lg transition-all cursor-pointer">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-green-100 text-green-700 text-sm font-medium rounded-full">Aberto</span>
              <span class="text-gray-400 text-sm">Prazo: 45 dias</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Prêmio Inovação 2024</h3>
            <p class="text-gray-600 mb-4">Reconheça as startups mais inovadoras do ano.</p>
            <div class="flex items-center text-accent-500 font-semibold">
              <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 100-2 1 1 0 000 2zm7-1a1 1 0 11-2 0 1 1 0 012 0zm-.464 5.535a1 1 0 10-1.415-1.414 3 3 0 01-4.242 0 1 1 0 00-1.415 1.414 5 5 0 007.072 0z"/>
              </svg>
              Prêmio: R$ 75.000
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Events Section */}
    <section id="eventos" class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Próximos Eventos</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Networking, workshops e conferências LATAM-China
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow-md overflow-hidden flex">
            <div class="w-24 bg-primary-500 flex flex-col items-center justify-center text-white p-4">
              <span class="text-2xl font-bold">15</span>
              <span class="text-sm">MAR</span>
            </div>
            <div class="p-6 flex-1">
              <span class="text-sm text-primary-500 font-medium">Workshop</span>
              <h3 class="text-lg font-bold text-gray-900 mt-1 mb-2">Design Thinking para Startups</h3>
              <div class="flex items-center text-gray-500 text-sm">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                14:00 - 17:00
                <span class="mx-2">•</span>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                </svg>
                Online
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-md overflow-hidden flex">
            <div class="w-24 bg-accent-500 flex flex-col items-center justify-center text-white p-4">
              <span class="text-2xl font-bold">22</span>
              <span class="text-sm">MAR</span>
            </div>
            <div class="p-6 flex-1">
              <span class="text-sm text-accent-500 font-medium">Networking</span>
              <h3 class="text-lg font-bold text-gray-900 mt-1 mb-2">Encontro de Empreendedores</h3>
              <div class="flex items-center text-gray-500 text-sm">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                18:00 - 21:00
                <span class="mx-2">•</span>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                </svg>
                São Paulo, SP
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>